<https://culturalcartography.net/names/raoul-vaneigem/#person> a foaf:Person ;
    rdfs:label "Raoul Vaneigem" ;
    dcterms:description "Vaneigem and Debord were introduced to one another by Lefebvre, and subsequently became two poles of Situationism. They traced Malcolm Lowry's steps outside Paris, high on mescalin, and conducted psychogeographic dérives in Antwerp, Barcelona and Brussels as well as Paris. Vaneigem described his friendship with Debord as \"founded on ether exuberance and rigorous thought.\" Lefebvre's work directly inspired Vaneigem and Debord's thought: they had both attended lectures by him, and he subsequestly interested himself in their ideas."@en ;
    rdfs:seeAlso <https://www.e-flux.com/journal/06/61400/in-conversation-with-raoul-vaneigem/>,
        <https://www.nothingness.org/SI/vaneigem.html> ;
    owl:sameAs wd:Q537924 ;
    foaf:familyName "Vaneigem" ;
    foaf:givenName "Raoul" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/raoul-vaneigem/>,
        <https://en.wikipedia.org/wiki/Raoul_Vaneigem> ;
    foaf:knows <https://culturalcartography.net/names/guy-debord/#person>,
        <https://culturalcartography.net/names/henri-lefebvre/#person>,
        <https://culturalcartography.net/names/michele-bernstein/#person> ;
    foaf:name "Raoul Vaneigem" ;
    wkw:birthPlaceText "Lessines, Belgium" ;
    wkw:datesText "1934 (Lessines, Belgium) –" ;
    wkw:sortKey "Vaneigem, Raoul" ;
    wkw:status "bio" ;
    wkw:wordpressId 4280 ;
    schema:birthDate "1934"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/situationist/#concept>,
        <https://culturalcartography.net/professions/writer/#concept> .

