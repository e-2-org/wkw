    wkw:datesText "1801 (Elberfeld, Germany) – 1868 (Bonn)" ;
    wkw:deathPlaceText "Bonn" ;
    wkw:sortKey "Plucker, Julius" ;
    wkw:status "bio" ;
    wkw:wordpressId 4027 ;
