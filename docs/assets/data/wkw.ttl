        <https://culturalcartography.net/names/theodore-gericault/#person>,
        <https://culturalcartography.net/names/thomas-couture/#person> ;
    foaf:name "Antoine-Jean Gros" ;
    wkw:birthPlaceText "Paris" ;
    wkw:datesText "1771 (Paris) – 1835 (Meudon, France)" ;
    wkw:deathPlaceText "Meudon, France" ;
    wkw:sortKey "Gros, Antoinejean" ;
