<https://culturalcartography.net/names/henri-bergson/#person> a foaf:Person ;
    rdfs:label "Henri Bergson" ;
    dcterms:description "Proust and Bergson knew each other through family connections: Proust always denied that Bergson's ideas had been influential on his own writing (the strength of insistence has led some to believe this shouldn't be taken too literally). The bilingual Bergson visited James when both were in London; James described him as a modest man, but intellectually a genius. The two had strong sympathy for each other's work. Valéry was influenced by Bergson, though also disagreed with him. In the debate with Einstein, Bergson is generally regarded as having come off second best."@en ;
    rdfs:seeAlso <https://authorscalendar.info/bergson.htm>,
        <https://plato.stanford.edu/entries/bergson>,
        <https://www.britannica.com/biography/Henri-Bergson>,
        <https://www.nobelprize.org/prizes/literature/1927/bergson/biographical/> ;
    owl:sameAs wd:Q42156 ;
    foaf:familyName "Bergson" ;
    foaf:givenName "Henri" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/henri-bergson/> ;
    foaf:knows <https://culturalcartography.net/names/albert-einstein/#person>,
        <https://culturalcartography.net/names/emile-durkheim/#person>,
        <https://culturalcartography.net/names/marcel-proust/#person>,
        <https://culturalcartography.net/names/pau-casals/#person>,
        <https://culturalcartography.net/names/paul-valery/#person>,
        <https://culturalcartography.net/names/rabindranath-tagore/#person>,
        <https://culturalcartography.net/names/william-james/#person> ;
    foaf:name "Henri Bergson" ;
    wkw:birthPlaceText "Paris" ;
    wkw:datesText "1859 (Paris) – 1941 (Paris)" ;
