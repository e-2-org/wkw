        <https://culturalcartography.net/names/joseph-banks/#person>,
        <https://culturalcartography.net/names/josiah-wedgwood/#person>,
        <https://culturalcartography.net/names/thomas-wedgwood/#person>,
        <https://culturalcartography.net/names/william-hunter/#person> ;
    foaf:name "George Stubbs" ;
    wkw:birthPlaceText "Liverpool" ;
    wkw:datesText "1724 (Liverpool) – 1806 (London)" ;
