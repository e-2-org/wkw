<https://culturalcartography.net/names/vasily-grossman/#person> a foaf:Person ;
    rdfs:label "Vasily Grossman" ;
    dcterms:description "Grossman – still too little known – was novelist turned celebrated war-reporter turned documenter-in-chief of Soviet murder of its own Jewish population. Gorky encouraged Grossman in his writing (stressing the need for socialist realism), invited him to his house, and proved the key to entry into official recognition, later stripped. Ehrenburg and Grossman, friends and colleagues, undertook the great task of gathering testimonies of the massacring of Soviet Jews into what became their 'Black Book': publication in the USSR was perhaps unsurprisingly suppressed. Platonov was a close friend — Grossman tried to persuade his editor to give him literary refuge."@en ;
    rdfs:seeAlso <https://en.gariwo.net/righteous/the-righteous-biographies/gulag-and-totalitarianism/exemplary-figures-reported-by-gariwo/vasily-grossman-7548.html>,
        <https://grossmanweb.eu/vasily-grossman/biografia/> ;
    owl:sameAs wd:Q313767 ;
    skos:altLabel "Vasily Semenovich Grossman;Vasily Semyonovich Grossman" ;
    foaf:familyName "Grossman" ;
    foaf:givenName "Vasily" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/vasily-grossman/>,
        <https://en.wikipedia.org/wiki/Vasily_Grossman> ;
    foaf:knows <https://culturalcartography.net/names/andrei-platonov/#person>,
        <https://culturalcartography.net/names/ilya-ehrenburg/#person> ;
    foaf:name "Vasily Grossman" ;
    wkw:birthPlaceText "Berdichev, now Berdychiv, Ukraine" ;
    wkw:datesText "1905 (Berdichev, now Berdychiv, Ukraine) – 1964 (Moscow)" ;
    wkw:deathPlaceText "Moscow" ;
    wkw:sortKey "Grossman, Vasily" ;
    wkw:status "bio" ;
    wkw:wordpressId 3586 ;
    schema:birthDate "1905"^^xsd:gYear ;
    schema:deathDate "1964"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/writer/#concept> .

