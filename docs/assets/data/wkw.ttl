        <https://culturalcartography.net/names/vicente-martin-y-soler/#person>,
        <https://culturalcartography.net/names/wolfgang-amadeus-mozart/#person> ;
    foaf:name "Michael Kelly" ;
    wkw:birthPlaceText "Dublin" ;
    wkw:datesText "1762 (Dublin) – 1826 (Margate, England)" ;
    wkw:deathPlaceText "Margate, England" ;
