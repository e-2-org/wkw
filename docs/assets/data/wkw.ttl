        <https://culturalcartography.net/names/paul-gavarni/#person>,
        <https://culturalcartography.net/names/william-makepeace-thackeray/#person> ;
    foaf:name "Constantin Guys" ;
    wkw:birthPlaceText "Vlissingen, Netherlands" ;
