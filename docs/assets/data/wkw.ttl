@prefix wkw: <https://culturalcartography.net/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wkw:approximateBirthYear a rdf:Property ;
    rdfs:comment "Birth year when WKW gives it as c. (circa)."@en .

wkw:approximateDeathYear a rdf:Property ;
    rdfs:comment "Death year when WKW gives it as c. (circa)."@en .

wkw:birthPlaceText a rdf:Property ;
    rdfs:comment "Place of birth as WKW gives it."@en .

wkw:datesText a rdf:Property ;
    rdfs:comment "Birth and death as WKW gives them, e.g. '1791 (London) – 1871 (London)'."@en .

wkw:deathPlaceText a rdf:Property ;
    rdfs:comment "Place of death as WKW gives it."@en .

wkw:notToBeConfusedWith a rdf:Property ;
    rdfs:comment "Another person in WKW who might be mistaken for this one."@en .

wkw:sortKey a rdf:Property ;
    rdfs:comment "The key WKW sorts this person by, e.g. 'Babbage, Charles'."@en .

wkw:status a rdf:Property ;
    rdfs:comment "'bio' if WKW has written this person up, 'stub' if they are only linked to so far."@en .

wkw:wordpressId a rdf:Property ;
    rdfs:comment "The person's post ID in the WordPress site, for tracing records back."@en .

