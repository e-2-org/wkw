<https://culturalcartography.net/names/richard-parkes-bonington/#person> a foaf:Person ;
    rdfs:label "Richard Parkes Bonington" ;
    dcterms:description "A shooting-star in the French art-world, Bonington died of tuberculosis at 25; his handling of light and form anticipated the Impressionists. His father illegally exported lace-making machinery to Calais, and based his family there. Moving on to Paris, where he studied under Gros, Bonington met Delacroix, who was making studies in the Louvre, and who described Bonington as a tall adolescent in a short coat. The two visited London, where they sketched armour, then shared a studio in Paris. Géricault became, through Delacroix, another close friend."@en ;
    rdfs:seeAlso <https://www.britannica.com/biography/Richard-Parkes-Bonington>,
        <https://www.nationalgallery.org.uk/artists/richard-parkes-bonington> ;
    owl:sameAs wd:Q380395 ;
    foaf:familyName "Bonington" ;
    foaf:givenName "Richard Parkes" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/richard-parkes-bonington/>,
        <https://en.wikipedia.org/wiki/Richard_Parkes_Bonington> ;
    foaf:knows <https://culturalcartography.net/names/antoine-jean-gros/#person>,
        <https://culturalcartography.net/names/eugene-delacroix/#person>,
        <https://culturalcartography.net/names/theodore-gericault/#person> ;
    foaf:name "Richard Parkes Bonington" ;
    wkw:birthPlaceText "Nottingham, England" ;
    wkw:datesText "1802 (Nottingham, England) – 1828 (London)" ;
    wkw:deathPlaceText "London" ;
    wkw:sortKey "Bonington, Richardparkes" ;
    wkw:status "bio" ;
    wkw:wordpressId 3213 ;
    schema:birthDate "1802"^^xsd:gYear ;
