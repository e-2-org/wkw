        <https://culturalcartography.net/names/juliette-greco/#person>,
        <https://culturalcartography.net/names/roland-petit/#person> ;
    foaf:name "Serge Gainsbourg" ;
    wkw:birthPlaceText "Paris" ;
    wkw:datesText "1928 (Paris) – 1991 (Paris)" ;
    wkw:deathPlaceText "Paris" ;
