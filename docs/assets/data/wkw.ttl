<https://culturalcartography.net/names/mikhail-lomonosov/#person> a foaf:Person ;
    rdfs:label "Mikhail Lomonosov" ;
    dcterms:description "Lomonosov was one of Russia's greatest scientists, though in his time was mainly known as a writer: a true polymath, he published work in physics, chemistry, geology, astronomy, classics, language and history, largely working alone. Wolff influentially taught him in Germany. He became Euler's assistant and later his close colleague in St Petersburg; they corresponded until Lomonosov's death. He stood as guarantor for his friend and colleague Gmelin, who defaulted (Euler intervened, Gmelin paid him back). He warmly supported Müller's explorations in Siberia, but (both were hot-headed) took violently against his theory of a Norse origin for the Russian nation."@en ;
    rdfs:seeAlso <https://physicsworld.com/a/mikhail-who/>,
        <https://www.britannica.com/biography/Mikhail-Vasilyevich-Lomonosov> ;
    owl:sameAs wd:Q58720 ;
    skos:altLabel "Mikhail Vasilyevich Lomonosov" ;
    foaf:familyName "Lomonosov" ;
    foaf:givenName "Mikhail" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/mikhail-lomonosov/>,
        <https://en.wikipedia.org/wiki/Mikhail_Lomonosov> ;
    foaf:knows <https://culturalcartography.net/names/christian-wolff-philosopher/#person>,
        <https://culturalcartography.net/names/gerhard-friedrich-muller/#person>,
        <https://culturalcartography.net/names/johann-georg-gmelin/#person>,
        <https://culturalcartography.net/names/leonhard-euler/#person>,
        <https://culturalcartography.net/names/stepan-krasheninnikov/#person> ;
    foaf:name "Mikhail Lomonosov" ;
    wkw:birthPlaceText "Denisovka, now Lomonosovo, Russia" ;
    wkw:datesText "1711 (Denisovka, now Lomonosovo, Russia) – 1765 (St Petersburg)" ;
    wkw:deathPlaceText "St Petersburg" ;
    wkw:sortKey "Lomonosov, Mikhail" ;
    wkw:status "bio" ;
    wkw:wordpressId 3806 ;
    schema:birthDate "1711"^^xsd:gYear ;
    schema:deathDate "1765"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/educationalist/#concept>,
        <https://culturalcartography.net/professions/natural-scientist/#concept>,
