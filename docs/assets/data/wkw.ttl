<https://culturalcartography.net/names/arcangelo-corelli/#person> a foaf:Person ;
    rdfs:label "Arcangelo Corelli" ;
    dcterms:description "Locatelli (informally) and Geminiani (formally) were among his students, and helped pass on his influential violin technique. When Handel as a young man was in Italy, he and Corelli moved in the same circles, colleagues but also rivals; the more conservative Corelli is said to have been offended by the advanced compositional demands Handel made upon the instrument (he actually refused to play one passage). Suggestions that Vivaldi may have also been among Corelli's students are most probably misinterpretation of the accepted fact that Vivaldi clearly studied and learned from his work, and was influenced by it."@en ;
    rdfs:seeAlso <https://www.allmusic.com/artist/arcangelo-corelli-mn0001190565/biography>,
        <https://www.hoasm.org/VIIIA/Corelli.html> ;
    owl:sameAs wd:Q164475 ;
    foaf:familyName "Corelli" ;
    foaf:givenName "Arcangelo" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/arcangelo-corelli/> ;
    foaf:knows <https://culturalcartography.net/names/alessandro-scarlatti/#person>,
        <https://culturalcartography.net/names/domenico-scarlatti/#person>,
        <https://culturalcartography.net/names/francesco-geminiani/#person>,
        <https://culturalcartography.net/names/george-frideric-handel/#person>,
        <https://culturalcartography.net/names/pietro-locatelli/#person> ;
    foaf:name "Arcangelo Corelli" ;
    wkw:birthPlaceText "Fusignano, Italy" ;
    wkw:datesText "1653 (Fusignano, Italy) – 1713 (Rome)" ;
    wkw:deathPlaceText "Rome" ;
    wkw:sortKey "Corelli, Arcangelo" ;
    wkw:status "bio" ;
