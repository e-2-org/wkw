        <https://culturalcartography.net/names/william-thomson-lord-kelvin/#person> ;
    foaf:name "Léon Foucault" ;
    wkw:birthPlaceText "Paris" ;
    wkw:datesText "1819 (Paris) – 1868 (Paris)" ;
