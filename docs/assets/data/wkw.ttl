<https://culturalcartography.net/names/etienne-jean-georget/#person> a foaf:Person ;
    rdfs:label "Étienne-Jean Georget" ;
    dcterms:description "Georget was a pioneer in psychiatric medicine, with an enlightened view of patients as individuals. Interested in identifying typical physiognomies, he commissioned his friend Géricault to paint a series of portraits of patients: both men died before the project was completed. Georget was Esquirol's dear student, as well as one of Pinel's, and extended the work of both; both Georget and Esquirol studied monomania, and identified mental fixation as a primary symptom, leading Romanticist musicians like Berlioz and writers like Musset, Sand and Balzac to extend the idea to fictional and autobiographical psychopathology."@en ;
    rdfs:seeAlso <https://courses.lumenlearning.com/arthistory2-91/chapter/portraits-of-the-insane/> ;
    owl:sameAs wd:Q3592011 ;
    foaf:familyName "Georget" ;
    foaf:givenName "Étienne-Jean" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/etienne-jean-georget/>,
        <https://en.wikipedia.org/wiki/Étienne-Jean_Georget> ;
    foaf:knows <https://culturalcartography.net/names/etienne-esquirol/#person>,
        <https://culturalcartography.net/names/philippe-pinel/#person>,
        <https://culturalcartography.net/names/theodore-gericault/#person> ;
    foaf:name "Étienne-Jean Georget" ;
    wkw:birthPlaceText "Vernon-sur-Brenne, France" ;
    wkw:datesText "1795 (Vernon-sur-Brenne, France) – 1828 (Paris)" ;
    wkw:deathPlaceText "Paris" ;
    wkw:sortKey "Georget, Etiennejean" ;
    wkw:status "bio" ;
    wkw:wordpressId 3531 ;
    schema:birthDate "1795"^^xsd:gYear ;
    schema:deathDate "1828"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/physician/#concept> .

