    schema:deathDate "1943"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/philosopher/#concept>,
        <https://culturalcartography.net/professions/social-activist/#concept> .

<https://culturalcartography.net/names/theophile-jules-pelouze/#person> a foaf:Person ;
    rdfs:label "Théophile-Jules Pelouze" ;
    dcterms:description "Pelouze worked as laboratory assistant for Gay-Lussac, collaborated with Liebig in Germany, and was also a colleague of Bunsen's. Berzelius was a good friend. Nobel, one of Pelouze's students, took nitroglycerine (the disconcerting discovery of another of Pelouze's students, Ascanio Sobrero) and developed and exploited it as a powerful yet safe explosive. Pelouze helped set up his friend Bernard's marriage, and gave him curare-tipped arrows so he could experiment with the poison's operation."@en ;
    rdfs:seeAlso <https://www.newadvent.org/cathen/11610b.htm> ;
    owl:sameAs wd:Q445815 ;
    foaf:familyName "Pelouze" ;
    foaf:givenName "Théophile-Jules" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/theophile-jules-pelouze/>,
        <https://en.wikipedia.org/wiki/Théophile-Jules_Pelouze>,
        <https://fr.wikipedia.org/wiki/Théophile-Jules_Pelouze> ;
    foaf:knows <https://culturalcartography.net/names/alfred-nobel/#person>,
