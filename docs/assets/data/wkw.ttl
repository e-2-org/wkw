<https://culturalcartography.net/names/henry-purcell/#person> a foaf:Person ;
    rdfs:label "Henry Purcell" ;
    dcterms:description "Purcell is generally regarded as one of the greatest English composers, and certainly the greatest of the baroque era, writing both for the church and for the theatre. He was a student – and became a great friend – of Blow, who resigned his position as organist at Westminster Abbey in Purcell's favour; Blow was devastated at Purcell's early death. Records of Purcell's life are unfortunately thin on the ground, and other than his close friendship and frequent collaboration with Dryden, the extent to which he might have known others whose work he contributed music to – Behn, Shadwell, Congreve, most notably – is unknown."@en ;
    rdfs:seeAlso <https://www.allmusic.com/artist/mn0000596040/biography>,
        <https://www.bbc.co.uk/music/artists/ddea5540-2c7d-4266-8507-b367c2635d35> ;
    owl:sameAs wd:Q9695 ;
    foaf:familyName "Purcell" ;
    foaf:givenName "Henry" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/henry-purcell/>,
        <https://en.wikipedia.org/wiki/Henry_Purcell> ;
    foaf:knows <https://culturalcartography.net/names/john-blow/#person>,
        <https://culturalcartography.net/names/john-dryden/#person> ;
    foaf:name "Henry Purcell" ;
    wkw:birthPlaceText "London" ;
    wkw:datesText "1659 (London) – 1695 (London)" ;
    wkw:deathPlaceText "London" ;
    wkw:sortKey "Purcell, Henry" ;
    wkw:status "bio" ;
    wkw:wordpressId 5988 ;
    schema:birthDate "1659"^^xsd:gYear ;
    schema:deathDate "1695"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/composer/#concept> .

