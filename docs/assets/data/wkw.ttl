<https://culturalcartography.net/names/isidore-isou/#person> a foaf:Person ;
    rdfs:label "Isidore Isou" ;
    dcterms:description "Just arrived in Paris, Isou barged into the baffled Gallimard's office and pronounced himself a saviour. He worked with Debord before splitting to form the Lettrist international. Lemaître was his main sidekick in the Lettrist movement; Lefebvre was briefly associated with it, and said that he met Isou several times."@en ;
    rdfs:seeAlso <https://www.thing.net/~grist/lnd/lettrist/isou.htm>,
        <https://www.ubu.com/sound/isou.html> ;
