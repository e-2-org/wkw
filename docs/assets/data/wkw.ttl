<https://culturalcartography.net/names/mary-astell/#person> a foaf:Person ;
    rdfs:label "Mary Astell" ;
    dcterms:description "Astell was a significant feminist avant la lettre, whose writings arguing for equality via education were widely noted, including by Defoe, Steele (mockingly) and Samuel Richardson. She studied astronomy with Flamsteed in Greenwich, and tried to persuade her close friend Montagu to publish her 'Turkish Letters', writing a preface to them. Astell didn't engage in London literary society, but associated with a group of independently-minded, mostly aristocratic women, including Montagu and Elstob. It is unknown whether or not Richardson knew her (they certainly had a friend in common) – his heroine Clarissa bore striking resemblances to the real Astell."@en ;
    rdfs:seeAlso <https://www.enotes.com/topics/mary-astell>,
        <https://www.iep.utm.edu/astell/>,
        <https://www.theambulist.co.uk/words-and-musings/heroines-seven-women/mary-astell> ;
    owl:sameAs wd:Q2359434 ;
    foaf:familyName "Astell" ;
    foaf:givenName "Mary" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/mary-astell/>,
        <https://en.wikipedia.org/wiki/Mary_Astell> ;
    foaf:knows <https://culturalcartography.net/names/elizabeth-elstob/#person>,
        <https://culturalcartography.net/names/john-flamsteed/#person>,
        <https://culturalcartography.net/names/mary-wortley-montagu/#person> ;
    foaf:name "Mary Astell" ;
    wkw:birthPlaceText "Newcastle-upon-Tyne, England" ;
    wkw:datesText "1666 (Newcastle-upon-Tyne, England) – 1731 (Chelsea)" ;
    wkw:deathPlaceText "Chelsea" ;
    wkw:sortKey "Astell, Mary" ;
    wkw:status "bio" ;
    wkw:wordpressId 6995 ;
    schema:birthDate "1666"^^xsd:gYear ;
    schema:deathDate "1731"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/pioneer-feminist/#concept>,
        <https://culturalcartography.net/professions/polemicist/#concept>,
        <https://culturalcartography.net/professions/writer/#concept> .

