<https://culturalcartography.net/names/aubrey-beardsley/#person> a foaf:Person ;
    rdfs:label "Aubrey Beardsley" ;
    dcterms:description "The 19-year-old Beardsley famously visited Burne-Jones uninvited and became his protégé. He also took his drawings to Morris who (perhaps unsurprisingly, given his beliefs) was not impressed. Valéry met him while visiting his aunt in London. Wilde became a close friend, Beardsley providing erotic illustrations for his Salomé, though Wilde's notoriety rebounded on Beardsley. He told Yeats that beauty was the most difficult of things. Whistler, a strong stylistic influence, refused an invitation to dine, though they did later meet, Beardsley subsequently caricaturing the older aesthete."@en ;
    rdfs:seeAlso <https://www.nytimes.com/books/99/02/21/reviews/990221.21vinct.html>,
        <https://www.victorianweb.org/art/illustration/beardsley/bio1.html> ;
    owl:sameAs wd:Q272566 ;
    foaf:familyName "Beardsley" ;
    foaf:givenName "Aubrey" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/aubrey-beardsley/> ;
    foaf:knows <https://culturalcartography.net/names/edward-burne-jones/#person>,
        <https://culturalcartography.net/names/james-mcneill-whistler/#person>,
        <https://culturalcartography.net/names/oscar-wilde/#person>,
        <https://culturalcartography.net/names/paul-valery/#person>,
        <https://culturalcartography.net/names/william-butler-yeats/#person>,
        <https://culturalcartography.net/names/william-morris/#person> ;
    foaf:name "Aubrey Beardsley" ;
    wkw:birthPlaceText "Brighton, England" ;
    wkw:datesText "1872 (Brighton, England) – 1898 (Menton, France)" ;
    wkw:deathPlaceText "Menton, France" ;
    wkw:sortKey "Beardsley, Aubrey" ;
    wkw:status "bio" ;
    wkw:wordpressId 3153 ;
