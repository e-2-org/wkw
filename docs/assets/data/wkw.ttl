<https://culturalcartography.net/names/carl-von-voit/#person> a foaf:Person ;
    rdfs:label "Carl von Voit" ;
    dcterms:description "Voit was a research student under Liebig at Giessen, bringing a biologist's skills to the nutritional work initiated by Liebig. On Liebig's advice he then spent a year studying under Wöhler in Göttingen. His work with Pettenkofer, an older Liebig student, established modern nutritional science. First an assistant at Pettenkofer's Munich laboratory, they became lifelong friends. Baeyer was a university colleague there. The biological journal he and Pettenkofer started became his way of staying in touch with developments; while Pettenkofer took care of the broader framework, Voit concentrated on the laboratory work."@en ;
    rdfs:seeAlso <https://www.britannica.com/biography/Carl-von-Voit> ;
    owl:sameAs wd:Q76146 ;
    foaf:familyName "Voit" ;
    foaf:givenName "Carl von" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/carl-von-voit/>,
        <https://en.wikipedia.org/wiki/Carl_von_Voit> ;
    foaf:knows <https://culturalcartography.net/names/adolf-von-baeyer/#person>,
        <https://culturalcartography.net/names/friedrich-wohler/#person>,
        <https://culturalcartography.net/names/justus-von-liebig/#person>,
        <https://culturalcartography.net/names/max-von-pettenkofer/#person> ;
    foaf:name "Carl von Voit" ;
    wkw:birthPlaceText "Amberg, Germany" ;
    wkw:datesText "1831 (Amberg, Germany) – 1908 (Munich)" ;
    wkw:deathPlaceText "Munich" ;
    wkw:sortKey "Voit, Carlvon" ;
    wkw:status "bio" ;
    wkw:wordpressId 4300 ;
    schema:birthDate "1831"^^xsd:gYear ;
    schema:deathDate "1908"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/physiologist/#concept> .

