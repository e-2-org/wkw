<https://culturalcartography.net/names/francis-bauer/#person> a foaf:Person ;
    rdfs:label "Francis Bauer" ;
    dcterms:description "Bauer's given name, Franz, was anglicised as Francis. Banks brought him to Kew, and provided him with an income. Talbot wrote to Bauer that he and Wheatstone would call on him to show him his 'photogenic drawings', and Niépce (visiting his sick brother in England) presented him with what is generally regarded as the first permanent photographic image. Hooker was Bauer's pupil. Bauer's brother Ferdinandhttps://en.wikipedia.org/wiki/Franz_Bauer is regarded as one of the greatest botanical illustrators."@en ;
    rdfs:seeAlso <https://www.botanicalartandartists.com/about-franz-bauer.html> ;
    owl:sameAs wd:Q938823 ;
    skos:altLabel "Franz Bauer" ;
    foaf:familyName "Bauer" ;
    foaf:givenName "Francis" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/francis-bauer/>,
        <https://en.wikipedia.org/wiki/Franz_Bauer> ;
    foaf:knows <https://culturalcartography.net/names/ferdinand-bauer/#person>,
        <https://culturalcartography.net/names/joseph-banks/#person>,
        <https://culturalcartography.net/names/nicephore-niepce/#person>,
        <https://culturalcartography.net/names/william-henry-fox-talbot/#person>,
        <https://culturalcartography.net/names/william-hooker/#person> ;
    foaf:name "Francis Bauer" ;
    wkw:birthPlaceText "Feldsberg, Austria" ;
    wkw:datesText "1758 (Feldsberg, Austria) – 1840 (Kew, England)" ;
    wkw:deathPlaceText "Kew, England" ;
    wkw:sortKey "Bauer, Francis" ;
    wkw:status "bio" ;
    wkw:wordpressId 3150 ;
    schema:birthDate "1758"^^xsd:gYear ;
    schema:deathDate "1840"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/botanical-illustrator/#concept> .

