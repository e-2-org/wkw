<https://culturalcartography.net/names/tommaso-giordani/#person> a foaf:Person ;
    rdfs:label "Tommaso Giordani" ;
    dcterms:description "The peripatetic Giordani spent most of his adult life in London and Dublin. Dublin is where he taught the precocious Field, who aged nine was sent by his family for a year's worth of \"finishing lessons.\" When Leopold Mozart was laid low by the English weather (in London with the young Wolfgang Amadeus and his sister), Giordani was the only one of his London acquaintances to visit him — twice a day, in fact. It is unclear what Giordani's relationship with Richard Brinsley Sheridan was, though he composed music for Sheridan's most popular play, 'The Critic.'"@en ;
    rdfs:seeAlso <https://www.allmusic.com/artist/tommaso-giordani-mn0001544454/biography> ;
    owl:sameAs wd:Q718406 ;
    foaf:familyName "Giordani" ;
    foaf:givenName "Tommaso" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/tommaso-giordani/>,
        <https://en.wikipedia.org/wiki/Tommaso_Giordani> ;
    foaf:knows <https://culturalcartography.net/names/john-field/#person>,
        <https://culturalcartography.net/names/leopold-mozart/#person> ;
    foaf:name "Tommaso Giordani" ;
    wkw:approximateBirthYear "1733"^^xsd:gYear ;
    wkw:birthPlaceText "Naples" ;
    wkw:datesText "c.1733 (Naples) – 1806 (Dublin)" ;
    wkw:deathPlaceText "Dublin" ;
    wkw:sortKey "Giordani, Tommaso" ;
    wkw:status "bio" ;
    wkw:wordpressId 3547 ;
    schema:deathDate "1806"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/composer/#concept>,
        <https://culturalcartography.net/professions/musician/#concept> .

