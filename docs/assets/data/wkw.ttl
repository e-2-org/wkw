    foaf:knows <https://culturalcartography.net/names/artie-shaw/#person>,
        <https://culturalcartography.net/names/dudley-murphy/#person>,
        <https://culturalcartography.net/names/ernest-hemingway/#person>,
        <https://culturalcartography.net/names/george-bernard-shaw/#person>,
        <https://culturalcartography.net/names/henry-miller/#person>,
        <https://culturalcartography.net/names/jean-sibelius/#person>,
        <https://culturalcartography.net/names/john-steinbeck/#person>,
        <https://culturalcartography.net/names/raymond-queneau/#person> ;
    foaf:name "William Saroyan" ;
    wkw:birthPlaceText "Fresno, Calif." ;
    wkw:datesText "1908 (Fresno, Calif.) – 1981 (Fresno)" ;
