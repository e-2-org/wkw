<https://culturalcartography.net/names/blasius-hueber/#person> a foaf:Person ;
    rdfs:label "Blasius Hueber" ;
    dcterms:description "Hueber worked as assistant to Anich, mapping the northern Tyrol, taking over after Anich's death. Both Hueber and Anich, farmers' sons from the same village outside Innsbruck and in many ways self-taught, were as mature men taught mathematics, physics, astronomy and the principles of surveying by Ignaz von Weinhart, a Jesuit scholar in Innsbruck. The 9-year-old Koch also helped Hueber survey the countryside."@en ;
    rdfs:seeAlso <https://www.inzing.tirol.gv.at/Blasius_Hueber_1735-1814_>,
        <https://www.kartengeschichte.ch/ch/summaries/e19d.html> ;
    owl:sameAs wd:Q776490 ;
    skos:altLabel "Blasius Hüber" ;
    foaf:familyName "Hueber" ;
    foaf:givenName "Blasius" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/blasius-hueber/> ;
    foaf:knows <https://culturalcartography.net/names/josef-anton-koch/#person>,
        <https://culturalcartography.net/names/peter-anich/#person> ;
    foaf:name "Blasius Hueber" ;
    wkw:birthPlaceText "Oberperfuss, Austria" ;
    wkw:datesText "1735 (Oberperfuss, Austria) – 1814 (Innsbruck)" ;
    wkw:deathPlaceText "Innsbruck" ;
    wkw:sortKey "Hueber, Blasius" ;
    wkw:status "bio" ;
