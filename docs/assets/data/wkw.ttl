        <https://culturalcartography.net/names/charles-alexandre-lesueur/#person>,
        <https://culturalcartography.net/names/charles-willson-peale/#person>,
        <https://culturalcartography.net/names/johann-heinrich-pestalozzi/#person>,
        <https://culturalcartography.net/names/joseph-neef/#person>,
        <https://culturalcartography.net/names/robert-owen/#person>,
        <https://culturalcartography.net/names/thomas-say/#person>,
        <https://culturalcartography.net/names/titian-peale/#person> ;
    foaf:name "William Maclure" ;
    wkw:birthPlaceText "Ayr, Scotland" ;
