    foaf:name "Giuseppe Sarti" ;
    wkw:birthPlaceText "Faenza, Italy" ;
    wkw:datesText "1729 (Faenza, Italy) – 1802 (Berlin)" ;
    wkw:deathPlaceText "Berlin" ;
