        <https://culturalcartography.net/names/jean-cocteau/#person>,
        <https://culturalcartography.net/names/joseph-conrad/#person>,
        <https://culturalcartography.net/names/sinclair-lewis/#person>,
        <https://culturalcartography.net/names/william-dean-howells/#person> ;
    foaf:name "Edith Wharton" ;
    wkw:birthPlaceText "New York" ;
    wkw:datesText "1862 (New York) – 1937 (Saint-Brice-sous-Forêt, France)" ;
    wkw:deathPlaceText "Saint-Brice-sous-Forêt, France" ;
