<https://culturalcartography.net/names/johann-christian-reinhart/#person> a foaf:Person ;
    rdfs:label "Johann Christian Reinhart" ;
    dcterms:description "Reinhart met Schiller as a young man: they became lifelong friends. In Rome, he befriended Thorvaldsen, Koch and Carstens, mainstays of the expatriate artist community. Reinhart is thought to have been responsible for mockingly giving the group of artists known as the Nazarenes their name: unlike his friend Koch, he did not dally with them. Koch and he together developed a heroic mode of landscape painting."@en ;
    rdfs:seeAlso <https://www.galerieneuse.de/en/collections2/old-master-paintings/19th-century/139-reinhart-johann-christian.html>,
        <https://www.hof.de/hof/hof_eng/living/joahhn-christian-reinhart-cabinett.html>,
        <https://www.sammlung.pinakothek.de/en/bookmark/artist/M0xyPBj4pl> ;
    owl:sameAs wd:Q214458 ;
    foaf:familyName "Reinhart" ;
    foaf:givenName "Johann Christian" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/johann-christian-reinhart/>,
        <https://en.wikipedia.org/wiki/Johann_Christian_Reinhart> ;
    foaf:knows <https://culturalcartography.net/names/a-j-carstens/#person>,
        <https://culturalcartography.net/names/bertel-thorvaldsen/#person>,
        <https://culturalcartography.net/names/friedrich-schiller/#person>,
        <https://culturalcartography.net/names/josef-anton-koch/#person> ;
    foaf:name "Johann Christian Reinhart" ;
    wkw:birthPlaceText "Hof, Bavaria, now Germany" ;
    wkw:datesText "1761 (Hof, Bavaria, now Germany) – 1847 (Rome)" ;
    wkw:deathPlaceText "Rome" ;
    wkw:sortKey "Reinhart, Johannchristian" ;
