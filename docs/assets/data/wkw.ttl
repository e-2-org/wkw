<https://culturalcartography.net/names/edward-turner/#person> a foaf:Person ;
    rdfs:label "Edward Turner" ;
    dcterms:description "Turner was the first professor of chemistry at University College London. He had studied under Stromeyer in Göttingen, and dedicated his 'Elements of Chemistry' to him. Draper studied with Turner, who first interested him in the chemical effects of light. Gregory became his assistant. Berzelius was among his correspondents. There are few sources of biographical information online."@en ;
    rdfs:seeAlso <https://www.chem.ucl.ac.uk/resources/history/people/turner.html> ;
    owl:sameAs wd:Q746683 ;
    foaf:familyName "Turner" ;
    foaf:givenName "Edward" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/edward-turner/>,
        <https://en.wikipedia.org/wiki/Edward_Turner_(chemist)> ;
    foaf:knows <https://culturalcartography.net/names/friedrich-stromeyer/#person>,
