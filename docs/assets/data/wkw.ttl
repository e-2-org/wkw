        <https://culturalcartography.net/names/rudolf-leuckart/#person>,
        <https://culturalcartography.net/names/simone-weil/#person> ;
    foaf:name "Ilya Mechnikov" ;
    wkw:birthPlaceText "Ivanivka, Ukraine" ;
    wkw:datesText "1845 (Ivanivka, Ukraine) – 1916 (Paris)" ;
    wkw:deathPlaceText "Paris" ;
    wkw:sortKey "Mechnikov, Ilya" ;
    wkw:status "bio" ;
    wkw:wordpressId 5237 ;
