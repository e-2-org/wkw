        <https://culturalcartography.net/names/rabindranath-tagore/#person> ;
    foaf:name "Buddhadeva Bose" ;
    wkw:birthPlaceText "Comilla, India, now Bangladesh" ;
    wkw:datesText "1908 (Comilla, India, now Bangladesh) – 1974 (Lucknow, India)" ;
    wkw:deathPlaceText "Lucknow, India" ;
    wkw:sortKey "Bose, Buddhadeva" ;
