<https://culturalcartography.net/names/sigismond-thalberg/#person> a foaf:Person ;
    rdfs:label "Sigismond Thalberg" ;
    dcterms:description "Sigismond (or Sigismund) Thalberg studied with Czerny, Hummel and Moscheles, and is widely regarded as a more significant pianist than composer. Mendelssohn engaged him to play in Leipzig. Schumann played duets with him. Liszt was his great rival as a virtuoso pianist; the two were brought together for a famous salon show-down in Paris."@en ;
    rdfs:seeAlso <https://www.allmusic.com/artist/sigismund-thalberg-mn0001801365/biography>,
        <https://www.nndb.com/people/114/000098817/> ;
    owl:sameAs wd:Q347871 ;
    skos:altLabel "Sigismund Thalberg" ;
    foaf:familyName "Thalberg" ;
    foaf:givenName "Sigismond" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/sigismond-thalberg/>,
        <https://en.wikipedia.org/wiki/Sigismond_Thalberg> ;
    foaf:knows <https://culturalcartography.net/names/carl-czerny/#person>,
