<https://culturalcartography.net/names/robert-edmond-grant/#person> a foaf:Person ;
    rdfs:label "Robert Edmond Grant" ;
    dcterms:description "Grant was a close friend and correspondent of Geoffroy, whom he'd met in France. Darwin met Grant while he was studying medicine in Edinburgh, becoming an enthusiastic student of the free-thinking biologist/anatomist. Grant took him to a talk by Audubon, whose wife had known Darwin's grandfather Erasmus, but there is no record of a direct personal connection. Darwin's close friendship with Grant ended when Grant felt that his student's discoveries threatened his own. It seems likely that Grant as a student in Paris met Lamarck, whose ideas he keenly espoused, but it is unclear. Faraday advised Grant on public speaking."@en ;
    rdfs:seeAlso <https://www.strangescience.net/grant.htm> ;
    owl:sameAs wd:Q679861 ;
    foaf:familyName "Grant" ;
    foaf:givenName "Robert Edmond" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/robert-edmond-grant/>,
        <https://en.wikipedia.org/wiki/Robert_Edmond_Grant> ;
    foaf:knows <https://culturalcartography.net/names/anthony-panizzi/#person>,
        <https://culturalcartography.net/names/charles-darwin/#person>,
        <https://culturalcartography.net/names/etienne-geoffroy-saint-hilaire/#person>,
        <https://culturalcartography.net/names/michael-faraday/#person> ;
    foaf:name "Robert Edmond Grant" ;
    wkw:birthPlaceText "Edinburgh" ;
    wkw:datesText "1793 (Edinburgh) – 1874 (London)" ;
    wkw:deathPlaceText "London" ;
    wkw:sortKey "Grant, Robertedmond" ;
    wkw:status "bio" ;
    wkw:wordpressId 3568 ;
    schema:birthDate "1793"^^xsd:gYear ;
    schema:deathDate "1874"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/comparative-anatomist/#concept>,
        <https://culturalcartography.net/professions/naturalist/#concept> .

<https://culturalcartography.net/names/robert-louis-stevenson/#person> a foaf:Person ;
    rdfs:label "Robert Louis Stevenson" ;
    dcterms:description "Stevenson wasn't a great socialiser. When James first came to visit, he was turned away, taken for a tradesman. However they became close lifelong friends; Stevenson gave him a copy of 'Kidnapped', and they exchanged letters world-wide. Sargent and Stevenson became friends as young men in Paris, where Sargent had gone to study; he painted three portraits of Stevenson, one destroyed (probably by Mrs Stevenson). Stevenson wrote to Twain that he'd read 'Huck Finn' four times; Twain visited him in his Greenwich Village hotel, sat with him in the sun, and wrote about his thin frame and beautiful eyes."@en ;
    rdfs:seeAlso <https://authorscalendar.info/rlsteven.htm>,
        <https://robert-louis-stevenson.org/life/> ;
    owl:sameAs wd:Q1512 ;
    skos:altLabel "R. L. Stevenson" ;
    foaf:familyName "Stevenson" ;
    foaf:givenName "Robert Louis" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/robert-louis-stevenson/>,
        <https://en.wikipedia.org/wiki/Robert_Louis_Stevenson> ;
    foaf:knows <https://culturalcartography.net/names/henry-james/#person>,
        <https://culturalcartography.net/names/john-addington-symonds/#person>,
        <https://culturalcartography.net/names/john-singer-sargent/#person>,
        <https://culturalcartography.net/names/mark-twain/#person> ;
    foaf:name "Robert Louis Stevenson" ;
    wkw:birthPlaceText "Edinburgh" ;
    wkw:datesText "1850 (Edinburgh) – 1894 (Vailima, Samoa)" ;
    wkw:deathPlaceText "Vailima, Samoa" ;
    wkw:sortKey "Stevenson, Robertlouis" ;
    wkw:status "bio" ;
    wkw:wordpressId 4211 ;
    schema:birthDate "1850"^^xsd:gYear ;
    schema:deathDate "1894"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/writer/#concept> .

