<https://culturalcartography.net/names/gaspare-spontini/#person> a foaf:Person ;
    rdfs:label "Gaspare Spontini" ;
    dcterms:description "Spontini met Paganini on a tour of German cities, and worked together with Wagner in Dresden — Wagner being impressed by the conductor's baton Spontini requested, black with white tips. Berlioz discovered his music as a student, later met and championed him, and later still wrote his obituary. Mendelssohn was met in Berlin – Spontini was apparently critical of the 17-year-old's operatic composition. He corresponded with Cherubini, wrote to Salieri praising the metronome, and asked Hoffmann to translate a text for him: Hoffmann promoted him as an honourary German."@en ;
    rdfs:seeAlso <https://www.allmusic.com/artist/gaspare-spontini-mn0001719639/biography>,
        <https://www.operamusica.com/artist/gaspare-spontini/#biography> ;
    owl:sameAs wd:Q168485 ;
    foaf:familyName "Spontini" ;
    foaf:givenName "Gaspare" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/gaspare-spontini/>,
        <https://en.wikipedia.org/wiki/Gaspare_Spontini> ;
    foaf:knows <https://culturalcartography.net/names/antonio-salieri/#person>,
        <https://culturalcartography.net/names/e-t-a-hoffmann/#person>,
        <https://culturalcartography.net/names/felix-mendelssohn/#person>,
        <https://culturalcartography.net/names/hector-berlioz/#person>,
        <https://culturalcartography.net/names/luigi-cherubini/#person>,
        <https://culturalcartography.net/names/niccolo-paganini/#person>,
        <https://culturalcartography.net/names/richard-wagner/#person> ;
    foaf:name "Gaspare Spontini" ;
    wkw:birthPlaceText "Maiolati, now Maiolati Spontini, Italy" ;
    wkw:datesText "1774 (Maiolati, now Maiolati Spontini, Italy) – 1851 (Maiolati)" ;
    wkw:deathPlaceText "Maiolati" ;
    wkw:sortKey "Spontini, Gaspare" ;
    wkw:status "bio" ;
    wkw:wordpressId 4199 ;
    schema:birthDate "1774"^^xsd:gYear ;
    schema:deathDate "1851"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/composer/#concept> .

<https://culturalcartography.net/names/george-engelmann/#person> a foaf:Person ;
    rdfs:label "George Engelmann" ;
    dcterms:description "Engelmann met Schimper, Agassiz and Braun while a student, continuing the association with Agassiz and Braun in Paris. He met Gray after he emigrated to the U.S. Torrey stayed with him, while Parry became entangled with another botanical collector in an argument over a rose, which Engelmann tried to defuse (Parry having a long and close friendship with him). Hooker was one of his many correspondents."@en ;
    rdfs:seeAlso <https://plants.jstor.org/stable/10.5555/al.ap.person.bm000002397>,
        <https://www.britannica.com/biography/George-Engelmann> ;
    owl:sameAs wd:Q214946 ;
