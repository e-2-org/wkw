<https://culturalcartography.net/names/torbern-bergman/#person> a foaf:Person ;
    rdfs:label "Torbern Bergman" ;
    dcterms:description "Bergman, who made important advances in the systematic analysis and chemical classification of minerals, and on stratification, is less widely-known than he might be, his work being published neither in Latin nor (for the most part) in English. He studied with and became a colleague of Linnaeus, whose ideas influenced him strongly. He followed his correspondent Priestley in making carbonated water, and was described by another correspondent, Werner, as cool-headed and sharp-minded. Guyton translated him into French, and Withering (for once) into English; Elhuyar, Gadolin and most notably Scheele were among his students."@en ;
    rdfs:seeAlso <https://www.britannica.com/biography/Torbern-Olof-Bergman>,
        <https://www.encyclopedia.com/people/science-and-technology/metallurgy-and-mining-biographies/torbern-olof-bergman> ;
    owl:sameAs wd:Q201347 ;
    skos:altLabel "Torbern Olaf Bergman;Torbern Olof Bergman" ;
    foaf:familyName "Bergman" ;
    foaf:givenName "Torbern" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/torbern-bergman/>,
        <https://en.wikipedia.org/wiki/Torbern_Bergman> ;
    foaf:knows <https://culturalcartography.net/names/abraham-gottlob-werner/#person>,
        <https://culturalcartography.net/names/carl-linnaeus/#person>,
        <https://culturalcartography.net/names/carl-wilhelm-scheele/#person>,
        <https://culturalcartography.net/names/fausto-elhuyar/#person>,
        <https://culturalcartography.net/names/johan-gadolin/#person>,
        <https://culturalcartography.net/names/joseph-priestley/#person>,
        <https://culturalcartography.net/names/louis-bernard-guyton-de-morveau/#person>,
        <https://culturalcartography.net/names/william-withering/#person> ;
    foaf:name "Torbern Bergman" ;
    wkw:birthPlaceText "Katerineberg, Sweden" ;
    wkw:datesText "1735 (Katerineberg, Sweden) – 1784 (Medevi)" ;
    wkw:deathPlaceText "Medevi" ;
    wkw:sortKey "Bergman, Torbern" ;
    wkw:status "bio" ;
    wkw:wordpressId 3177 ;
    schema:birthDate "1735"^^xsd:gYear ;
