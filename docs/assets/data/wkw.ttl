<https://culturalcartography.net/names/james-mill/#person> a foaf:Person ;
    rdfs:label "James Mill" ;
    dcterms:description "Moving to London, Mill met Bentham, becoming his close friend and enthusiastic supporter. He gave his son John Stuart Mill an extremely rigorous home education, dedicated to grooming him as his own and Bentham's intellectual successor (not surprisingly, this hothousing led to the son's mental breakdown). Mill was responsible for persuading his close friend and frequent visitor Ricardo to publish what became his most important work on economics. Dumont (like Ricardo) was another member of the circle around Bentham. Mill's job at the East India Company, where he supervised Peacock, enabled him shamelessly to help his son."@en ;
    rdfs:seeAlso <https://plato.stanford.edu/entries/james-mill> ;
    owl:sameAs wd:Q271666 ;
    foaf:familyName "Mill" ;
    foaf:givenName "James" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/james-mill/>,
        <https://en.wikipedia.org/wiki/James_Mill> ;
    foaf:knows <https://culturalcartography.net/names/david-ricardo/#person>,
        <https://culturalcartography.net/names/dugald-stewart/#person>,
        <https://culturalcartography.net/names/jeremy-bentham/#person>,
        <https://culturalcartography.net/names/john-stuart-mill/#person>,
        <https://culturalcartography.net/names/pierre-etienne-louis-dumont/#person>,
        <https://culturalcartography.net/names/thomas-love-peacock/#person> ;
    foaf:name "James Mill" ;
    wkw:birthPlaceText "North Water Bridge, Scotland" ;
    wkw:datesText "1773 (North Water Bridge, Scotland) – 1836 (London)" ;
    wkw:deathPlaceText "London" ;
