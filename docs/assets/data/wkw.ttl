<https://culturalcartography.net/names/vincent-chevalier/#person> a foaf:Person ;
    rdfs:label "Vincent Chevalier" ;
    dcterms:description "The well-known lens-maker Chevalier provided Niépce as well as Daguerre with sophisticated compound lenses, cutting-edge technological craftsmanship of the day — in the case of Daguerre, initially for his dioramas. Daguerre is said to have got Niépce's address from Chevalier when he first wanted to make contact, Chevalier having mentioned Niépce's experiments with fixing an image. Charles Chevalier was his (pushier) son: they worked in partnership for ten years before Charles set up his own business. Their compound microscope lenses were equally renowned."@en ;
    rdfs:seeAlso <https://www.niepce-daguerre.com/Vincent_et_C_Chevalier.html>,
        <https://www.niepce-daguerre.com/triplet%20de%20Chevalier.html>,
        <https://www.oldphotographiclenses.com/chevalier.html>,
        <https://www.skinnerinc.com/auctions/2283/lots/1605> ;
    owl:sameAs wd:Q3559535 ;
    foaf:familyName "Chevalier" ;
    foaf:givenName "Vincent" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/vincent-chevalier/> ;
    foaf:knows <https://culturalcartography.net/names/charles-chevalier/#person>,
        <https://culturalcartography.net/names/louis-jacques-mande-daguerre/#person>,
        <https://culturalcartography.net/names/nicephore-niepce/#person> ;
    foaf:name "Vincent Chevalier" ;
    wkw:birthPlaceText "?Paris" ;
    wkw:datesText "1770 (?Paris) – 1841 (?Paris)" ;
    wkw:deathPlaceText "?Paris" ;
    wkw:sortKey "Chevalier, Vincent" ;
    wkw:status "bio" ;
    wkw:wordpressId 3312 ;
    schema:birthDate "1770"^^xsd:gYear ;
    schema:deathDate "1841"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/lens-maker/#concept> .

