        <https://culturalcartography.net/names/oscar-wilde/#person>,
        <https://culturalcartography.net/names/robert-louis-stevenson/#person>,
        <https://culturalcartography.net/names/walt-whitman/#person> ;
    foaf:name "John Addington Symonds" ;
    wkw:birthPlaceText "Bristol, England" ;
    wkw:datesText "1840 (Bristol, England) – 1893 (Rome)" ;
    wkw:deathPlaceText "Rome" ;
