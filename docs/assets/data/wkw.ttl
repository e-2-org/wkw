        <https://culturalcartography.net/names/frederick-law-olmsted/#person>,
        <https://culturalcartography.net/names/john-torrey/#person>,
        <https://culturalcartography.net/names/joseph-henry/#person> ;
    foaf:name "Andrew Jackson Downing" ;
    wkw:birthPlaceText "Newburgh, N.Y." ;
    wkw:datesText "1815 (Newburgh, N.Y.) – 1852 (New York)" ;
    wkw:deathPlaceText "New York" ;
    wkw:sortKey "Downing, Andrewjackson" ;
    wkw:status "bio" ;
