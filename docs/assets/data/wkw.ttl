        <https://culturalcartography.net/names/joseph-neef/#person>,
        <https://culturalcartography.net/names/karl-bodmer/#person>,
        <https://culturalcartography.net/names/robert-owen/#person>,
        <https://culturalcartography.net/names/titian-peale/#person>,
        <https://culturalcartography.net/names/william-maclure/#person> ;
    foaf:name "Thomas Say" ;
    wkw:birthPlaceText "Philadelphia" ;
    wkw:datesText "1787 (Philadelphia) – 1834 (New Harmony, Ind.)" ;
    wkw:deathPlaceText "New Harmony, Ind." ;
