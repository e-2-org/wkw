<https://culturalcartography.net/names/louis-jacques-mande-daguerre/#person> a foaf:Person ;
    rdfs:label "Louis-Jacques-Mandé Daguerre" ;
    dcterms:description "After a career in theatrical spectacle (he was responsible for the Paris and London dioramas, and had been a scene-painter for the Paris Opera), Daguerre joined with Niépce to develop the first permanent form of photography. Morse, who met Daguerre in Paris, may or may not have taken the process back with him, but was one of the first to make daguerrotypes in North America. Arago got government funding for Daguerre and Niépce's work thus allowing the technique to be made public, though the latter had by then died."@en ;
    rdfs:seeAlso <https://scihi.org/making-photography-really-operational-louis-daguerre/>,
        <https://www.metmuseum.org/toah/hd/dagu/hd_dagu.htm> ;
    owl:sameAs wd:Q131405 ;
    foaf:familyName "Daguerre" ;
    foaf:givenName "Louis-Jacques-Mandé" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/louis-jacques-mande-daguerre/>,
        <https://en.wikipedia.org/wiki/Louis_Daguerre> ;
    foaf:knows <https://culturalcartography.net/names/francois-arago/#person>,
        <https://culturalcartography.net/names/nicephore-niepce/#person>,
        <https://culturalcartography.net/names/samuel-morse/#person>,
        <https://culturalcartography.net/names/vincent-chevalier/#person> ;
    foaf:name "Louis-Jacques-Mandé Daguerre" ;
    wkw:birthPlaceText "Cormeilles Parisis, France" ;
    wkw:datesText "1787 (Cormeilles Parisis, France) – 1851 (Bry-sur-Marne)" ;
