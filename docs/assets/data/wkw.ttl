        <https://culturalcartography.net/names/carleton-watkins/#person>,
        <https://culturalcartography.net/names/gustave-dore/#person>,
        <https://culturalcartography.net/names/james-dwight-dana/#person>,
        <https://culturalcartography.net/names/john-ruskin/#person>,
        <https://culturalcartography.net/names/louis-agassiz/#person>,
        <https://culturalcartography.net/names/robert-ridgway/#person>,
        <https://culturalcartography.net/names/timothy-osullivan/#person> ;
    foaf:name "Clarence King" ;
    wkw:birthPlaceText "Newport, R.I." ;
