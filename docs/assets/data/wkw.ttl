        <https://culturalcartography.net/names/hans-bellmer/#person>,
        <https://culturalcartography.net/names/john-heartfield/#person> ;
    foaf:name "Otto Dix" ;
    wkw:birthPlaceText "Untermhaus, Germany" ;
    wkw:datesText "1891 (Untermhaus, Germany) – 1969 (Singen)" ;
    wkw:deathPlaceText "Singen" ;
    wkw:sortKey "Dix, Otto" ;
    wkw:status "bio" ;
    wkw:wordpressId 3406 ;
    schema:birthDate "1891"^^xsd:gYear ;
