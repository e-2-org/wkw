<https://culturalcartography.net/names/otto-dix/#person> a foaf:Person ;
    rdfs:label "Otto Dix" ;
    dcterms:description "Dix and his friend Grosz were the two most relentlessly uncompromising depictors of the effects on German society of World War I. He knew Grosz, and Heartfield, from Berlin Dada days, although his flirtation with that movement was brief. Sander, another friend, credited conversations with Dix as formative in his own great unfinished project. Bellmer met him as a young engineering student."@en ;
    rdfs:seeAlso <https://www.tate.org.uk/art/lists/five-things-know-otto-dix>,
        <https://www.theguardian.com/artanddesign/2014/may/14/first-world-war-german-art-otto-dix> ;
    owl:sameAs wd:Q153104 ;
    foaf:familyName "Dix" ;
    foaf:givenName "Otto" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/otto-dix/>,
        <https://en.wikipedia.org/wiki/Otto_Dix> ;
