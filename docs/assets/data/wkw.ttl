<https://culturalcartography.net/names/walter-serner/#person> a foaf:Person ;
    rdfs:label "Walter Serner" ;
    dcterms:description "Serner faked a medical certificate for Jung that enabled him to desert, and joined in Cabaret Voltaire events in Zürich with Arp, Schad and Tzara (who however later marginalised Serner's influence on the Dada group). The inveterate traveller Serner accompanied his closest friend Schad to Naples, Geneva and Frankfurt, went to Paris with Picabia and Tzara, and was seen by Éluard in Geneva (again). Arp said that no-one knew what became of him, though having been deported to Terezin in 1942, he was transported onward and died, perhaps in Riga. Richter described him as \"an idealist in a world of pragmatists.\""@en ;
    rdfs:seeAlso <https://www.exil-archiv.de/html/biografien/serner.htm>,
        <https://www.pwf.cz/rubriky/projects/walter-serner-prize/walter-serner/walter-serner-a-handguide-for-impostors_8059.html>,
        <https://www.twistedspoon.com/serner.html> ;
    owl:sameAs wd:Q646146 ;
    skos:altLabel "Walter Eduard Seligmann" ;
    foaf:familyName "Serner" ;
    foaf:givenName "Walter" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/walter-serner/> ;
    foaf:knows <https://culturalcartography.net/names/christian-schad/#person>,
        <https://culturalcartography.net/names/francis-picabia/#person>,
        <https://culturalcartography.net/names/franz-jung/#person>,
        <https://culturalcartography.net/names/hans-arp/#person>,
        <https://culturalcartography.net/names/hans-richter/#person>,
        <https://culturalcartography.net/names/paul-eluard/#person>,
        <https://culturalcartography.net/names/tristan-tzara/#person> ;
    foaf:name "Walter Serner" ;
    wkw:birthPlaceText "Karlsbad, now Karlovy Vary, Czech Republic" ;
    wkw:datesText "1889 (Karlsbad, now Karlovy Vary, Czech Republic) – 1942 (?Riga, Latvia)" ;
    wkw:deathPlaceText "?Riga, Latvia" ;
    wkw:sortKey "Serner, Walter" ;
    wkw:status "bio" ;
    wkw:wordpressId 4156 ;
    schema:birthDate "1889"^^xsd:gYear ;
    schema:deathDate "1942"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/writer/#concept> .

<https://culturalcartography.net/names/wilfred-bion/#person> a foaf:Person ;
    rdfs:label "Wilfred Bion" ;
    dcterms:description "Bion was an original and influential psychoanalyst who led the equally-influential Tavistock Clinic. Klein gave him a training analysis. Bion once sat next to Ross at a dinner. Bowlby and Winnicott were Tavistock colleagues, Bowlby having worked alongside Bion on wartime officer selection. Lacan met him on a study-visit to England, and was influenced by his work. Beckett went to Bion while depressed and suffering from panic-attacks, but doubted that the treatment did him much good (other than being impressed by a lecture of Jung's that Bion took him to)."@en ;
    rdfs:seeAlso <https://psychoanalysis.org.uk/our-authors-and-theorists/wilfred-bion>,
        <https://www.karnacbooks.com/Author.asp?AID=922> ;
    owl:sameAs wd:Q526206 ;
    foaf:familyName "Bion" ;
    foaf:givenName "Wilfred" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/wilfred-bion/>,
        <https://en.wikipedia.org/wiki/Wilfred_Bion> ;
    foaf:knows <https://culturalcartography.net/names/carl-jung/#person>,
        <https://culturalcartography.net/names/donald-winnicott/#person>,
        <https://culturalcartography.net/names/jacques-lacan/#person>,
        <https://culturalcartography.net/names/john-bowlby/#person>,
        <https://culturalcartography.net/names/melanie-klein/#person>,
        <https://culturalcartography.net/names/ronald-ross/#person>,
        <https://culturalcartography.net/names/samuel-beckett/#person> ;
    foaf:name "Wilfred Bion" ;
    wkw:birthPlaceText "Muttra, now Mathura, India" ;
    wkw:datesText "1897 (Muttra, now Mathura, India) – 1979 (Oxford)" ;
    wkw:deathPlaceText "Oxford" ;
    wkw:sortKey "Bion, Wilfred" ;
    wkw:status "bio" ;
