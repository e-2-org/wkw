<https://culturalcartography.net/names/jean-duvignaud/#person> a foaf:Person ;
    rdfs:label "Jean Duvignaud" ;
    dcterms:description "Duvignaud taught Perec at school, and encouraged him in his writing. Perec later became, along with Virilio, Duvignaud's main collaborator on the review 'Cause Commune.' Barthes had founded the journal 'Théâtre populaire' with him, subsequently working with him on another, 'Arguments.'"@en ;
    rdfs:seeAlso <https://www.lemonde.fr/web/article/0,1-0@2-3382,36-869521@51-730592,0.html> ;
    owl:sameAs wd:Q926000 ;
