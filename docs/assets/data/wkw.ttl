<https://culturalcartography.net/names/james-stirling-mathematician/#person> a foaf:Person ;
    rdfs:label "James Stirling, mathematician" ;
    dcterms:description "Stirling made small but significant advances to the work of both Newton, whose friendship he enjoyed during his decade in London, and Euler, who wrote congratulating him on the usefulness of his results. Maclaurin, a friend, respected his work and appears to have tried to help his career, though Stirling's support of the Jacobites worked against him. De Moivre, working on similar problems, corresponded, as did Clairaut and Bradley. Arbuthnot proposed Stirling's election to the Royal Society; however, distracted by mining business, Stirling himself took 2 years to reply to Euler, and failed to propose him in turn."@en ;
    rdfs:seeAlso <https://www-history.mcs.st-andrews.ac.uk/Biographies/Stirling.html>,
        <https://www.britannica.com/biography/James-Stirling-British-mathematician>,
        <https://www.geo.ed.ac.uk/scotgaz/people/famousfirst828.html>,
        <https://www.nndb.com/people/125/000097831/> ;
    foaf:familyName "Stirling, mathematician" ;
    foaf:givenName "James" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/james-stirling-mathematician/> ;
    foaf:knows <https://culturalcartography.net/names/abraham-de-moivre/#person>,
        <https://culturalcartography.net/names/alexis-clairaut/#person>,
        <https://culturalcartography.net/names/colin-maclaurin/#person>,
        <https://culturalcartography.net/names/isaac-newton/#person>,
        <https://culturalcartography.net/names/james-bradley/#person>,
        <https://culturalcartography.net/names/john-arbuthnot/#person>,
        <https://culturalcartography.net/names/leonhard-euler/#person> ;
    foaf:name "James Stirling, mathematician" ;
    wkw:birthPlaceText "Garden, Scotland" ;
    wkw:datesText "1692 (Garden, Scotland) – 1770 (Edinburgh)" ;
    wkw:deathPlaceText "Edinburgh" ;
    wkw:sortKey "Stirlingmathematician, James" ;
    wkw:status "bio" ;
    wkw:wordpressId 5948 ;
    schema:birthDate "1692"^^xsd:gYear ;
