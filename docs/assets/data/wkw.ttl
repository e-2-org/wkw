        <https://culturalcartography.net/names/johannes-peter-muller/#person>,
        <https://culturalcartography.net/names/julian-huxley/#person>,
        <https://culturalcartography.net/names/rudolf-virchow/#person>,
        <https://culturalcartography.net/names/thomas-henry-huxley/#person> ;
    foaf:name "Ernst Haeckel" ;
    wkw:birthPlaceText "Potsdam, Germany" ;
    wkw:datesText "1834 (Potsdam, Germany) – 1919 (Jena)" ;
    wkw:deathPlaceText "Jena" ;
