<https://culturalcartography.net/names/friedrich-bessel/#person> a foaf:Person ;
    rdfs:label "Friedrich Bessel" ;
    dcterms:description "Bessel, who left school at 14, was the first to bring acute mathematical accuracy to astronomical measurement; he also discovered the existence of White Dwarfs. Olbers encouraged him to become an astronomer. Gauss met him as an observatory assistant, became a close friend, and later recommended him for an honorary doctorate (to facilitate his appointment to the new Königsberg observatory). He met his admiring correspondent Herschel (with whom he stayed), and Babbage, on a visit to England. Neumann and Jacobi, university colleagues, worked with him to reform the Prussian education system."@en ;
    rdfs:seeAlso <https://www-history.mcs.st-andrews.ac.uk/Biographies/Bessel.html> ;
    owl:sameAs wd:Q75845 ;
    foaf:familyName "Bessel" ;
    foaf:givenName "Friedrich" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/friedrich-bessel/>,
        <https://en.wikipedia.org/wiki/Friedrich_Wilhelm_Bessel> ;
    foaf:knows <https://culturalcartography.net/names/alexander-von-humboldt/#person>,
        <https://culturalcartography.net/names/carl-friedrich-gauss/#person>,
        <https://culturalcartography.net/names/carl-jacobi/#person>,
        <https://culturalcartography.net/names/charles-babbage/#person>,
        <https://culturalcartography.net/names/franz-neumann/#person>,
        <https://culturalcartography.net/names/franz-xaver-von-zach/#person>,
        <https://culturalcartography.net/names/johann-franz-encke/#person>,
        <https://culturalcartography.net/names/johann-gottfried-galle/#person>,
        <https://culturalcartography.net/names/john-herschel/#person>,
        <https://culturalcartography.net/names/wilhelm-olbers/#person> ;
    foaf:name "Friedrich Bessel" ;
    wkw:birthPlaceText "Minden, Germany" ;
    wkw:datesText "1784 (Minden, Germany) – 1846 (Königsberg, now Kaliningrad, Russia)" ;
    wkw:deathPlaceText "Königsberg, now Kaliningrad, Russia" ;
    wkw:sortKey "Bessel, Friedrich" ;
    wkw:status "bio" ;
