        <https://culturalcartography.net/names/jonathan-swift/#person>,
        <https://culturalcartography.net/names/joseph-addison/#person>,
        <https://culturalcartography.net/names/william-congreve/#person> ;
    foaf:name "Richard Steele" ;
    wkw:birthPlaceText "Dublin" ;
