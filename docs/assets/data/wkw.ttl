        <https://culturalcartography.net/names/victoria-ocampo/#person> ;
    foaf:name "José Ortega y Gasset" ;
    wkw:birthPlaceText "Madrid" ;
    wkw:datesText "1883 (Madrid) – 1955 (Madrid)" ;
    wkw:deathPlaceText "Madrid" ;
