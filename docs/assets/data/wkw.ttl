<https://culturalcartography.net/names/jean-simeon-chardin/#person> a foaf:Person ;
    rdfs:label "Jean-Siméon Chardin" ;
    dcterms:description "The substantially self-taught Chardin is particularly known for his acutely-observed still lives and for his atmospheric use of light and shade — both strongly influenced by Dutch rather than French painting. Diderot met him through his official role as an academician, and became both a friend and a perceptive champion of his work (he admiringly described him as 'grand magicien' and commented that no-one ever watched him painting). Fragonard was briefly apprenticed to him. Boucher, Chardin's close contemporary (and artistic opposite) was his neighbour in the Louvre apartments provided by the king."@en ;
    rdfs:seeAlso <https://www.artchive.com/artchive/C/chardin.html>,
        <https://www.britannica.com/biography/Jean-Baptiste-Simeon-Chardin> ;
    owl:sameAs wd:Q207447 ;
    skos:altLabel "Jean-Baptiste-Siméon Chardin" ;
    foaf:familyName "Chardin" ;
    foaf:givenName "Jean-Siméon" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/jean-simeon-chardin/>,
        <https://en.wikipedia.org/wiki/Jean-Baptiste-Simeon_Chardin> ;
    foaf:knows <https://culturalcartography.net/names/denis-diderot/#person>,
        <https://culturalcartography.net/names/francois-boucher/#person>,
        <https://culturalcartography.net/names/jean-honore-fragonard/#person>,
        <https://culturalcartography.net/names/quentin-de-la-tour/#person> ;
    foaf:name "Jean-Siméon Chardin" ;
    wkw:birthPlaceText "Paris" ;
