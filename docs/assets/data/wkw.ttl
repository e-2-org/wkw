        <https://culturalcartography.net/names/wolfgang-amadeus-mozart/#person> ;
    foaf:name "Franz Xaver Richter" ;
    wkw:birthPlaceText "Holleschau, Moravia, now Holešov, Czech Republic" ;
    wkw:datesText "1709 (Holleschau, Moravia, now Holešov, Czech Republic) – 1789 (Strasbourg, France)" ;
    wkw:deathPlaceText "Strasbourg, France" ;
    wkw:sortKey "Richter, Franzxaver" ;
