<https://culturalcartography.net/names/carl-auer-von-welsbach/#person> a foaf:Person ;
    rdfs:label "Carl Auer von Welsbach" ;
    dcterms:description "Auer von Welsbach is known for his isolation of new chemical elements, his work with rare earths, and his production of radically-improved gas-mantles, lighter-flints and light-bulbs. He did his doctoral research under Bunsen and Kirchhoff at Heidelberg; following Bunsen's death, he acquired his library. Aston and Rutherford were among his correspondents; he sent Rutherford radioactive isotopes to experiment with."@en ;
    rdfs:seeAlso <https://www.worldofchemicals.com/484/chemistry-articles/carl-auer-von-welsbach-discoverer-of-gas-mantle-neodymium-praseodymium-elements.html> ;
    owl:sameAs wd:Q89390 ;
    skos:altLabel "Carl Auer" ;
    foaf:familyName "Welsbach" ;
    foaf:givenName "Carl Auer von" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/carl-auer-von-welsbach/>,
        <https://en.wikipedia.org/wiki/Carl_Auer_von_Welsbach> ;
    foaf:knows <https://culturalcartography.net/names/ernest-rutherford/#person>,
        <https://culturalcartography.net/names/francis-william-aston/#person>,
        <https://culturalcartography.net/names/gustav-kirchhoff/#person>,
        <https://culturalcartography.net/names/robert-wilhelm-bunsen/#person> ;
    foaf:name "Carl Auer von Welsbach" ;
    wkw:birthPlaceText "Vienna" ;
    wkw:datesText "1858 (Vienna) – 1929 (Mölbling, Austria)" ;
    wkw:deathPlaceText "Mölbling, Austria" ;
    wkw:sortKey "Auervonwelsbach, Carl" ;
    wkw:status "bio" ;
    wkw:wordpressId 3120 ;
    schema:birthDate "1858"^^xsd:gYear ;
    schema:deathDate "1929"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/chemist/#concept>,
        <https://culturalcartography.net/professions/inventor/#concept> .

<https://culturalcartography.net/names/carl-gotthard-langhans/#person> a foaf:Person ;
    rdfs:label "Carl Gotthard Langhans" ;
    dcterms:description "Langhans and David Gilly (to become friends as well as colleagues) moved to Berlin within a year of one another, persuaded by the Prussian king following successful careers elsewhere. Together they were responsible for initiating a distinct Prussian school of architecture, founded in neo-classicism, though unafraid later to embrace gothic influences. David Gilly's son Friedrich was one of the students at the academy that Langhans and he set up: Langhans also joined the younger Gilly and others, including Schinkel and Gentz, in a dynamic group who met to discuss and advance their architectural ideas."@en ;
    rdfs:seeAlso <https://www.visual-arts-cork.com/architecture/carl-gotthard-langhans.htm> ;
    owl:sameAs wd:Q313181 ;
    foaf:familyName "Langhans" ;
    foaf:givenName "Carl Gotthard" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/carl-gotthard-langhans/>,
        <https://de.wikipedia.org/wiki/Carl_Gotthard_Langhans>,
        <https://en.wikipedia.org/wiki/Carl_Gotthard_Langhans> ;
    foaf:knows <https://culturalcartography.net/names/david-gilly/#person>,
        <https://culturalcartography.net/names/friedrich-gilly/#person>,
        <https://culturalcartography.net/names/heinrich-gentz/#person>,
        <https://culturalcartography.net/names/karl-friedrich-schinkel/#person> ;
    foaf:name "Carl Gotthard Langhans" ;
    wkw:birthPlaceText "Landeshut, Silesia, now Kamienna Góra, Poland" ;
    wkw:datesText "1732 (Landeshut, Silesia, now Kamienna Góra, Poland) – 1808 (Breslau, Silesia, now Wrocław, Poland)" ;
    wkw:deathPlaceText "Breslau, Silesia, now Wrocław, Poland" ;
    wkw:sortKey "Langhans, Carlgotthard" ;
    wkw:status "bio" ;
    wkw:wordpressId 3758 ;
    schema:birthDate "1732"^^xsd:gYear ;
    schema:deathDate "1808"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/architect/#concept> .

