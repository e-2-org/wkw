        <https://culturalcartography.net/names/voltaire/#person>,
        <https://culturalcartography.net/names/wolfgang-amadeus-mozart/#person> ;
    foaf:name "Giacomo Casanova" ;
    wkw:birthPlaceText "Venice" ;
    wkw:datesText "1725 (Venice) – 1798 (Dux, Bohemia, now Duchcov, Czech Republic)" ;
