<https://culturalcartography.net/names/j-r-r-tolkien/#person> a foaf:Person ;
    rdfs:label "J. R. R. Tolkien" ;
    dcterms:description "Lewis was Tolkien's closest and longest-lasting friend, though for complex reasons the friendship cooled in later years. Auden was an early supporter of Tolkien's writing, a regular correspondent and good friend. Avedon, who'd never met Tolkien, knocked on his door to give him a birthday cake. When Clarke invited Lewis to meet in an Oxford pub to explore their opposing standpoints on life and technology, Lewis took Tolkien along as his 'second' (as Cleaver was for Clarke). It seems hard to imagine people more poles apart; they duly failed to appreciate each other's view of the world, and decided to get drunk instead."@en ;
    rdfs:seeAlso <https://authorscalendar.info/tolkien.htm> ;
    owl:sameAs wd:Q892 ;
    foaf:familyName "Tolkien" ;
    foaf:givenName "J. R. R." ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/j-r-r-tolkien/>,
        <https://en.wikipedia.org/wiki/J._R._R._Tolkien> ;
    foaf:knows <https://culturalcartography.net/names/arthur-c-clarke/#person>,
        <https://culturalcartography.net/names/c-s-lewis/#person>,
        <https://culturalcartography.net/names/richard-avedon/#person>,
        <https://culturalcartography.net/names/valentine-cleaver/#person>,
        <https://culturalcartography.net/names/w-h-auden/#person> ;
    foaf:name "J. R. R. Tolkien" ;
    wkw:birthPlaceText "Bloemfontein, Orange Free State, now South Africa" ;
    wkw:datesText "1892 (Bloemfontein, Orange Free State, now South Africa) – 1973 (Bournemouth, England)" ;
    wkw:deathPlaceText "Bournemouth, England" ;
    wkw:sortKey "Tolkien, Jrr" ;
    wkw:status "bio" ;
    wkw:wordpressId 4254 ;
    schema:birthDate "1892"^^xsd:gYear ;
    schema:deathDate "1973"^^xsd:gYear ;
