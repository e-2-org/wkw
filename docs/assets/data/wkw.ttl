<https://culturalcartography.net/names/alessandro-manzoni/#person> a foaf:Person ;
    rdfs:label "Alessandro Manzoni" ;
    dcterms:description "Goethe translated one of his novels, publicly defended his work, and corresponded with him; Manzoni was convinced that he owed much of his fame to Goethe. Stendhal met Manzoni when he settled in Milan; he was subsequently banished for associating with members of the patriotic movement like him. Verdi composed his celebrated 'Requiem' for his hero, following his death; the two had met only once, through a mutual friend, Verdi respecting the older writer's extreme shyness and desire for privacy."@en ;
    owl:sameAs wd:Q1064 ;
    foaf:familyName "Manzoni" ;
    foaf:givenName "Alessandro" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/alessandro-manzoni/>,
        <https://en.wikipedia.org/wiki/Alessandro_Manzoni> ;
    foaf:knows <https://culturalcartography.net/names/giuseppe-verdi/#person>,
        <https://culturalcartography.net/names/johann-wolfgang-von-goethe/#person>,
        <https://culturalcartography.net/names/stendhal/#person> ;
    foaf:name "Alessandro Manzoni" ;
    wkw:birthPlaceText "Milan" ;
    wkw:datesText "1785 (Milan) – 1873 (Milan)" ;
    wkw:deathPlaceText "Milan" ;
    wkw:sortKey "Manzoni, Alessandro" ;
    wkw:status "bio" ;
    wkw:wordpressId 3839 ;
    schema:birthDate "1785"^^xsd:gYear ;
    schema:deathDate "1873"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/writer/#concept> .

