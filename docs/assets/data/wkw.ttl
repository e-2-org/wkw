<https://culturalcartography.net/names/martin-heinrich-klaproth/#person> a foaf:Person ;
    rdfs:label "Martin Heinrich Klaproth" ;
    dcterms:description "Klaproth, described as \"incorruptibly accurate\", was a pioneer of analytic chemistry, discovering or co-discovering several metallic elements. Berzelius, the truly great chemist of the age, was a correspondent, and closely involved in the discovery or identification of some of the same elements. Van Marum also corresponded with Klaproth, while Humboldt made a point of introducing his friend Gay-Lussac to him. Bode was a professional colleague; Klaproth's naming of uranium, after Uranus, helped seal the planet's agreed name. Werner was both student and friend, while the orientalist Julius Klaproth was his son."@en ;
    rdfs:seeAlso <https://scihi.org/martin-heinrich-klaproth-analytical-chemistry/>,
        <https://www.britannica.com/biography/Martin-Heinrich-Klaproth> ;
    owl:sameAs wd:Q160196 ;
    foaf:familyName "Klaproth" ;
    foaf:givenName "Martin Heinrich" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/martin-heinrich-klaproth/>,
        <https://en.wikipedia.org/wiki/Martin_Heinrich_Klaproth> ;
    foaf:knows <https://culturalcartography.net/names/abraham-gottlob-werner/#person>,
        <https://culturalcartography.net/names/alexander-von-humboldt/#person>,
        <https://culturalcartography.net/names/johann-elert-bode/#person>,
        <https://culturalcartography.net/names/jons-jakob-berzelius/#person>,
        <https://culturalcartography.net/names/joseph-louis-gay-lussac/#person>,
        <https://culturalcartography.net/names/julius-heinrich-klaproth/#person>,
        <https://culturalcartography.net/names/martin-van-marum/#person> ;
    foaf:name "Martin Heinrich Klaproth" ;
    wkw:birthPlaceText "Wernigerode, Germany" ;
    wkw:datesText "1743 (Wernigerode, Germany) – 1817 (Berlin)" ;
    wkw:deathPlaceText "Berlin" ;
    wkw:sortKey "Klaproth, Martinheinrich" ;
