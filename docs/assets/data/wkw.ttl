<https://culturalcartography.net/names/viking-eggeling/#person> a foaf:Person ;
    rdfs:label "Viking Eggeling" ;
    dcterms:description "Modigliani, befriended with Arp in Paris, painted Eggeling's portrait. Janco (with Richter, Tzara and Arp) was a Zürich Dada friend and colleague. Richter and Eggeling — they had been introduced to one another by Eggeling's close friend Tzara, in 1918 — worked intensively together for three years, their skills mutually complementary, bringing (in Richter's words) \"time and motion to painting.\" Van Doesburg, intrigued by their ideas, travelled from the Netherlands to Berlin to see Richter and Eggeling's work, and wrote about it in 'de Stijl'."@en ;
    rdfs:seeAlso <https://monoskop.org/Viking_Eggeling>,
        <https://stendhalgallery.com/?page_id=1917> ;
    owl:sameAs wd:Q2165063 ;
    foaf:familyName "Eggeling" ;
