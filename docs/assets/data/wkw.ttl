        <https://culturalcartography.net/names/marlene-dietrich/#person>,
        <https://culturalcartography.net/names/yves-montand/#person> ;
    foaf:name "Édith Piaf" ;
    wkw:birthPlaceText "Paris" ;
    wkw:datesText "1915 (Paris) – 1963 (Plascassier, France)" ;
    wkw:deathPlaceText "Plascassier, France" ;
    wkw:sortKey "Piaf, Edith" ;
