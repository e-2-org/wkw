        <https://culturalcartography.net/names/raymond-aron/#person>,
        <https://culturalcartography.net/names/romain-rolland/#person>,
        <https://culturalcartography.net/names/simone-weil/#person> ;
    foaf:name "Alain" ;
    wkw:birthPlaceText "Mortagne-au-Perche, France" ;
    wkw:datesText "1868 (Mortagne-au-Perche, France) – 1951 (Le Vésinet)" ;
    wkw:deathPlaceText "Le Vésinet" ;
    wkw:sortKey "Alain" ;
