<https://culturalcartography.net/names/francois-quesnay/#person> a foaf:Person ;
    rdfs:label "François Quesnay" ;
    dcterms:description "Quesnay was among the first to apply analytic principles to economic thought, and was an important precursor to the subsequent generation of classical economists. His role as surgeon to the king's mistress (in a generally despotic court) gave him a privileged position, his rooms a sanctuary for the circle of free-thinkers he gathered around him. These included Diderot and d'Alembert (a real friend — Quesnay was also a very competent mathematician), Buffon, Helvétius, Marmontel and Quesnay's student Turgot. Hume visited him, as did Smith, who got to know him well (and credited him in 'The Wealth of Nations')."@en ;
    rdfs:seeAlso <https://www.britannica.com/biography/Francois-Quesnay>,
        <https://www.newworldencyclopedia.org/entry/François_Quesnay> ;
    owl:sameAs wd:Q13575 ;
    foaf:familyName "Quesnay" ;
    foaf:givenName "François" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/francois-quesnay/>,
        <https://en.wikipedia.org/wiki/François_Quesnay> ;
    foaf:knows <https://culturalcartography.net/names/adam-smith/#person>,
        <https://culturalcartography.net/names/anne-robert-jacques-turgot/#person>,
        <https://culturalcartography.net/names/claude-adrien-helvetius/#person>,
        <https://culturalcartography.net/names/comte-de-buffon/#person>,
        <https://culturalcartography.net/names/david-hume/#person>,
        <https://culturalcartography.net/names/denis-diderot/#person>,
        <https://culturalcartography.net/names/jean-francois-marmontel/#person>,
        <https://culturalcartography.net/names/jean-le-rond-dalembert/#person> ;
    foaf:name "François Quesnay" ;
    wkw:birthPlaceText "Merey, France" ;
    wkw:datesText "1694 (Merey, France) – 1774 (Versailles)" ;
    wkw:deathPlaceText "Versailles" ;
    wkw:sortKey "Quesnay, Francois" ;
    wkw:status "bio" ;
    wkw:wordpressId 4052 ;
    schema:birthDate "1694"^^xsd:gYear ;
    schema:deathDate "1774"^^xsd:gYear ;
