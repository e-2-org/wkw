        <https://culturalcartography.net/names/rudolf-kohlrausch/#person>,
        <https://culturalcartography.net/names/william-siemens/#person> ;
    foaf:name "Wilhelm Weber" ;
    wkw:birthPlaceText "Wittenberg, Germany" ;
    wkw:datesText "1804 (Wittenberg, Germany) – 1891 (Göttingen)" ;
    wkw:deathPlaceText "Göttingen" ;
