        <https://culturalcartography.net/names/richard-huelsenbeck/#person>,
        <https://culturalcartography.net/names/robert-creeley/#person>,
        <https://culturalcartography.net/names/robert-duncan/#person> ;
    foaf:name "John Chamberlain" ;
    wkw:birthPlaceText "Rochester, Ind." ;
    wkw:datesText "1927 (Rochester, Ind.) –" ;
    wkw:sortKey "Chamberlain, John" ;
