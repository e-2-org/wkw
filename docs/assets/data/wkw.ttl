<https://culturalcartography.net/names/johann-mayrhofer/#person> a foaf:Person ;
    rdfs:label "Johann Mayrhofer" ;
    dcterms:description "This chronically self-deprecating and depressive poet was an important influence on Schubert, and one of those who regularly foregathered with him to sing his songs. Schubert set dozens of his poems to music (starting the first time they met), and they collaborated on an opera. They shared lodgings for 3 years (\"two somewhat impractical gentlemen\", their landlady said), and although the friendship eventually broke down, he wrote an elegy on Schubert's death. Senn and Bruchmann were among his other friends (and Schubert's). He impressed Bauernfeld, though the two didn't exactly like each other."@en ;
    rdfs:seeAlso <https://www.interlude.hk/front/muses-musingslusty-eye-music-guy-johann-mayrhofer-franz-schubert/> ;
    owl:sameAs wd:Q86566 ;
    foaf:familyName "Mayrhofer" ;
    foaf:givenName "Johann" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/johann-mayrhofer/>,
        <https://en.wikipedia.org/wiki/Johann_Mayrhofer> ;
    foaf:knows <https://culturalcartography.net/names/eduard-von-bauernfeld/#person>,
        <https://culturalcartography.net/names/franz-schubert/#person>,
        <https://culturalcartography.net/names/franz-von-bruchmann/#person>,
        <https://culturalcartography.net/names/johann-senn/#person> ;
    foaf:name "Johann Mayrhofer" ;
    wkw:birthPlaceText "Traunkreise, Austria" ;
    wkw:datesText "1787 (Traunkreise, Austria) – 1836 (Vienna)" ;
    wkw:deathPlaceText "Vienna" ;
    wkw:sortKey "Mayrhofer, Johann" ;
