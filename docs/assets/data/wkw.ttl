<https://culturalcartography.net/names/heinrich-berghaus/#person> a foaf:Person ;
    rdfs:label "Heinrich Berghaus" ;
    dcterms:description "Berghaus and the explorer/scientist Humboldt drew extensively on each other's pioneering expertise; for example the graphic representation of isotherms reflects Humboldt's researches and Berghaus' exceptional cartographic enterprise (his astonishing thematic maps can be regarded as pure scientific knowledge). Hermann Berghaus was Berghaus' nephew and professional colleague."@en ;
    rdfs:seeAlso <https://libweb5.princeton.edu/visual_materials/maps/websites/thematic-maps/landmark-thematic-atlases/landmark-thematic-atlases.html> ;
    owl:sameAs wd:Q67485 ;
    foaf:familyName "Berghaus" ;
    foaf:givenName "Heinrich" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/heinrich-berghaus/>,
        <https://en.wikipedia.org/wiki/Heinrich_Berghaus> ;
    foaf:knows <https://culturalcartography.net/names/alexander-von-humboldt/#person>,
        <https://culturalcartography.net/names/hermann-berghaus/#person> ;
    foaf:name "Heinrich Berghaus" ;
    wkw:birthPlaceText "Kleve, Germany" ;
    wkw:datesText "1797 (Kleve, Germany) – 1884 (Stettin, Germany, now Szczecin, Poland)" ;
    wkw:deathPlaceText "Stettin, Germany, now Szczecin, Poland" ;
    wkw:sortKey "Berghaus, Heinrich" ;
    wkw:status "bio" ;
    wkw:wordpressId 3175 ;
