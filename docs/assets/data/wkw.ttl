<https://culturalcartography.net/names/peter-anich/#person> a foaf:Person ;
    rdfs:label "Peter Anich" ;
    dcterms:description "Anich, the so-called 'peasant cartographer', drew outstanding maps, as well as building astronomical instruments, sundials and globes. He worked on his father's farm till age 28, then went to study mathematics, physics and astronomy with Ignaz von Weinhart in Innsbruck. While Weinhart supervised production of Anich and Hueber's famous 'Atlas Tyrolensis', Anich — like his assistant and successor Hueber, another farmer's son from the same village — was in mhttps://www.innsbruck.info/en/facilities/details/infrastruktur/anich-hueber-museum-oberperfuss.htmlany ways self-taught in surveying and cartography."@en ;
    rdfs:seeAlso <https://www.innsbruck.info/en/facilities/details/infrastruktur/anich-hueber-museum-oberperfuss.html> ;
    owl:sameAs wd:Q87919 ;
    foaf:familyName "Anich" ;
    foaf:givenName "Peter" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/peter-anich/>,
        <https://de.wikipedia.org/wiki/Peter_Anich> ;
    foaf:knows <https://culturalcartography.net/names/blasius-hueber/#person> ;
    foaf:name "Peter Anich" ;
    wkw:birthPlaceText "Oberperfuss, Austria" ;
    wkw:datesText "1723 (Oberperfuss, Austria) – 1766 (Oberperfuss)" ;
    wkw:deathPlaceText "Oberperfuss" ;
    wkw:sortKey "Anich, Peter" ;
    wkw:status "bio" ;
    wkw:wordpressId 3097 ;
    schema:birthDate "1723"^^xsd:gYear ;
    schema:deathDate "1766"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/cartographer/#concept> .

