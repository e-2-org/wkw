<https://culturalcartography.net/names/hablot-knight-browne/#person> a foaf:Person ;
    rdfs:label "Hablot Knight Browne" ;
    dcterms:description "Dickens and Browne were friends as well as close collaborators. Dickens took him on in person — Thackeray also applied, and helped Browne celebrate by taking him out for a dinner of sausages and stout. Dickens and Browne travelled everywhere together in the early years of their long working relationship, and played battledore and shuttlecock together. His illustrations for many of Dickens' best-known novels did much to shape the public perception of the characters. When Browne took over illustrating the serialised 'Pickwick Papers', sales increased a hundred-fold. Eventually, after 23 years, they drifted apart."@en ;
    rdfs:seeAlso <https://www.victorianweb.org/art/illustration/phiz/bio.html> ;
    owl:sameAs wd:Q2737410 ;
    skos:altLabel "Phiz" ;
    foaf:familyName "Browne" ;
    foaf:givenName "Hablot Knight" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/hablot-knight-browne/>,
        <https://en.wikipedia.org/wiki/Hablot_Knight_Browne> ;
    foaf:knows <https://culturalcartography.net/names/charles-dickens/#person>,
        <https://culturalcartography.net/names/william-makepeace-thackeray/#person> ;
    foaf:name "Hablot Knight Browne" ;
    wkw:birthPlaceText "London" ;
    wkw:datesText "1815 (London) – 1882 (Brighton, England)" ;
    wkw:deathPlaceText "Brighton, England" ;
    wkw:sortKey "Browne, Hablotknight" ;
    wkw:status "bio" ;
    wkw:wordpressId 3252 ;
    schema:birthDate "1815"^^xsd:gYear ;
    schema:deathDate "1882"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/illustrator/#concept> .

