<https://culturalcartography.net/names/pierre-magnol/#person> a foaf:Person ;
    rdfs:label "Pierre Magnol" ;
    dcterms:description "A pioneering botanist and innovator in the classification of plants, Magnol was the first to use the term 'family' of a natural grouping. The magnolia was named in his honour, by Linnaeus. Based most of his life in Montpellier, renowned for the study of botany and medicine, Magnol's best-known students were Tournefort and Jussieu; Tournefort dying relatively young, Magnol succeeded him at the Jardin du Roi in Paris before returning to Montpellier. Ray (who was impressed by him), Sloane and Locke (who both became friends) were among those who visited him, Locke receiving seeds for the physic garden at Oxford."@en ;
    rdfs:seeAlso <https://www.encyclopedia.com/doc/1G2-2830902761.html> ;
    owl:sameAs wd:Q522664 ;
    skos:editorialNote "Linked Pierre Magnol and Antoine de Jussieu: Magnol's bio: 'Magnol's best-known students were Tournefort and Jussieu'"@en,
        "Removed the link between Pierre Magnol and Antoine Laurent de Jussieu: Magnol died in 1715; Antoine-Laurent de Jussieu was born in 1748"@en ;
    foaf:familyName "Magnol" ;
    foaf:givenName "Pierre" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/pierre-magnol/>,
        <https://en.wikipedia.org/wiki/Pierre_Magnol> ;
    foaf:knows <https://culturalcartography.net/names/antoine-de-jussieu/#person>,
        <https://culturalcartography.net/names/hans-sloane/#person>,
        <https://culturalcartography.net/names/john-locke/#person>,
        <https://culturalcartography.net/names/john-ray/#person>,
        <https://culturalcartography.net/names/joseph-pitton-de-tournefort/#person> ;
    foaf:name "Pierre Magnol" ;
    wkw:birthPlaceText "Montpellier, France" ;
    wkw:datesText "1638 (Montpellier, France) – 1715 (Montpellier)" ;
    wkw:deathPlaceText "Montpellier" ;
    wkw:sortKey "Magnol, Pierre" ;
    wkw:status "bio" ;
    wkw:wordpressId 6057 ;
    schema:birthDate "1638"^^xsd:gYear ;
    schema:deathDate "1715"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/botanist/#concept> .

