        <https://culturalcartography.net/names/ludwig-van-beethoven/#person>,
        <https://culturalcartography.net/names/wolfgang-amadeus-mozart/#person> ;
    foaf:name "Emanuel Aloys Förster" ;
    wkw:birthPlaceText "Niedersteine, Silesia, now Ścinawka, Poland" ;
