<https://culturalcartography.net/names/j-j-grandville/#person> a foaf:Person ;
    rdfs:label "J. J. Grandville" ;
    dcterms:description "The bizarre and fantastic illustration of Grandville (the pen-name of Jean-Ignace-Isidore Gérard) anticipated the later work of the Surrealists; Breton and Bataille saw him as a significant precursor. His more overtly political work often led to attempts at suppression. Daumier, friend as well as colleague, worked alongside him on the journal 'La Caricature'. The young prodigy Doré, whom Grandville met as a teenager, found him inspirational. Dumas also knew him, and described him as melancholic and reserved, adding that he smoked and drank little."@en ;
    rdfs:seeAlso <https://bonjourparis.com/art/infinite-jest-brilliant-satire-parisian-cartoonist-jj-grandville/> ;
    owl:sameAs wd:Q744442 ;
    skos:altLabel "Jean-Jacques Grandville;Jean-Ignace-Isidore Gérard" ;
    foaf:familyName "Grandville" ;
    foaf:givenName "J. J." ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/j-j-grandville/>,
        <https://en.wikipedia.org/wiki/Jean_Ignace_Isidore_Gérard>,
        <https://fr.wikipedia.org/wiki/Grandville> ;
    foaf:knows <https://culturalcartography.net/names/alexandre-dumas-pere/#person>,
        <https://culturalcartography.net/names/gustave-dore/#person>,
        <https://culturalcartography.net/names/honore-daumier/#person> ;
    foaf:name "J. J. Grandville" ;
    wkw:birthPlaceText "Nancy, France" ;
    wkw:datesText "1803 (Nancy, France) – 1847 (Vanves)" ;
    wkw:deathPlaceText "Vanves" ;
    wkw:sortKey "Grandville, Jj" ;
