        <https://culturalcartography.net/names/samuel-taylor-coleridge/#person>,
        <https://culturalcartography.net/names/thomas-bewick/#person>,
        <https://culturalcartography.net/names/william-hazlitt/#person>,
        <https://culturalcartography.net/names/william-wordsworth/#person> ;
    foaf:name "John Keats" ;
    wkw:birthPlaceText "London" ;
    wkw:datesText "1795 (London) – 1821 (Rome)" ;
