<https://culturalcartography.net/names/gaetano-donizetti/#person> a foaf:Person ;
    rdfs:label "Gaetano Donizetti" ;
    dcterms:description "Mendelssohn met Donizetti in Naples. Rossini invited him for his first visit to Paris, to present an opera there. Sax befriended him in Paris, though he was forced to abandon his plans to include Sax's instruments in an opera score. He was very dedicated to Bellini, and wrote a requiem in his memory following his early death. Verdi was saddened to see his friend's state of decline when he visited him institutionalised in Paris — Donizetti had been a strong influence on him."@en ;
    rdfs:seeAlso <https://www.allmusic.com/artist/gaetano-donizetti-mn0000089579/biography>,
        <https://www.britannica.com/biography/Gaetano-Donizetti> ;
    owl:sameAs wd:Q101698 ;
    foaf:familyName "Donizetti" ;
    foaf:givenName "Gaetano" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/gaetano-donizetti/>,
        <https://en.wikipedia.org/wiki/Gaetano_Donizetti> ;
    foaf:knows <https://culturalcartography.net/names/adolphe-sax/#person>,
        <https://culturalcartography.net/names/felix-mendelssohn/#person>,
