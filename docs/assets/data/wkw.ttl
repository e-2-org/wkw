<https://culturalcartography.net/names/thomas-attwood/#person> a foaf:Person ;
    rdfs:label "Thomas Attwood" ;
    dcterms:description "Attwood — probably better-known as organist than as composer — studied with Mozart. He and Kelly visited Mozart's father Leopold with a plan hatched with the younger Mozart to visit London, but nothing came of it. Mendelssohn, a much younger friend, twice visited Attwood on the outskirts of London. Potter was among his students."@en ;
    rdfs:seeAlso <https://www.allmusic.com/artist/thomas-attwood-mn0001197981/biography> ;
    owl:sameAs wd:Q2422110 ;
    foaf:familyName "Attwood" ;
    foaf:givenName "Thomas" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/thomas-attwood/>,
