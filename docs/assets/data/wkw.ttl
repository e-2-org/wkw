<https://culturalcartography.net/names/tobias-mayer/#person> a foaf:Person ;
    rdfs:label "Tobias Mayer" ;
    dcterms:description "Mayer is known for lunar observation, particularly in relation to navigation; he also drew superb lunar maps. Mayer wrote to Euler (who had already heard of the young man) about astronomical refraction and lunar theory; they corresponded for four years, and Euler helped him to a professorship. Lacaille and Mayer wrote to each other particularly about the 1761 Passage of Venus, each arguing that the other's instrument was less accurate than his own (Mayer was right, though Lacaille wasn't to know it). Lambert, interested like Mayer in colour perception, visited him in Göttingen, and extended his work."@en ;
    rdfs:seeAlso <https://www-history.mcs.st-andrews.ac.uk/Biographies/Mayer_Tobias.html>,
        <https://www.britannica.com/biography/Johann-Tobias-Mayer> ;
    owl:sameAs wd:Q60406 ;
    foaf:familyName "Mayer" ;
    foaf:givenName "Tobias" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/tobias-mayer/>,
        <https://en.wikipedia.org/wiki/Tobias_Mayer> ;
    foaf:knows <https://culturalcartography.net/names/johann-heinrich-lambert/#person>,
        <https://culturalcartography.net/names/leonhard-euler/#person>,
        <https://culturalcartography.net/names/nicolas-louis-de-lacaille/#person> ;
    foaf:name "Tobias Mayer" ;
    wkw:birthPlaceText "Marbach, Germany" ;
    wkw:datesText "1723 (Marbach, Germany) – 1762 (Göttingen)" ;
    wkw:deathPlaceText "Göttingen" ;
    wkw:sortKey "Mayer, Tobias" ;
    wkw:status "bio" ;
    wkw:wordpressId 3859 ;
    schema:birthDate "1723"^^xsd:gYear ;
    schema:deathDate "1762"^^xsd:gYear ;
