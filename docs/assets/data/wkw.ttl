<https://culturalcartography.net/names/ignaz-venetz/#person> a foaf:Person ;
    rdfs:label "Ignaz Venetz" ;
    dcterms:description "Venetz picked up on and developed ideas about puzzling aspects of glaciation before his better-known friend and colleague Charpentier, whom he helped to persuade. They were in the habit of meeting and discussing ideas, as they did when Agassiz (and Schimper) came to stay with Charpentier in 1836; it was these two younger men who developed a full theory of glaciation and of a widespread ice-age."@en ;
    rdfs:seeAlso <https://www.hls-dhs-dss.ch/textes/f/F19428.php> ;
    owl:sameAs wd:Q115896 ;
    skos:altLabel "Ignace Venetz" ;
    foaf:familyName "Venetz" ;
    foaf:givenName "Ignaz" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/ignaz-venetz/>,
        <https://en.wikipedia.org/wiki/Ignaz_Venetz>,
        <https://fr.wikipedia.org/wiki/Ignace_Venetz> ;
    foaf:knows <https://culturalcartography.net/names/jean-de-charpentier/#person>,
        <https://culturalcartography.net/names/louis-agassiz/#person> ;
    foaf:name "Ignaz Venetz" ;
    wkw:birthPlaceText "Visperterminen, Switzerland" ;
    wkw:datesText "1788 (Visperterminen, Switzerland) – 1859 (Sion)" ;
    wkw:deathPlaceText "Sion" ;
    wkw:sortKey "Venetz, Ignaz" ;
    wkw:status "bio" ;
    wkw:wordpressId 4286 ;
    schema:birthDate "1788"^^xsd:gYear ;
    schema:deathDate "1859"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/botanist/#concept>,
        <https://culturalcartography.net/professions/engineer/#concept>,
        <https://culturalcartography.net/professions/geologist/#concept> .

