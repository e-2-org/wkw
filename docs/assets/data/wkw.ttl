        <https://culturalcartography.net/names/charles-coulomb/#person>,
        <https://culturalcartography.net/names/gaspard-monge/#person>,
        <https://culturalcartography.net/names/jean-charles-de-borda/#person>,
        <https://culturalcartography.net/names/jean-le-rond-dalembert/#person>,
        <https://culturalcartography.net/names/marquis-de-condorcet/#person>,
        <https://culturalcartography.net/names/robert-fulton/#person> ;
    foaf:name "Charles Bossut" ;
