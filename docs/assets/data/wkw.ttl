        <https://culturalcartography.net/names/gilbert-stuart/#person>,
        <https://culturalcartography.net/names/john-trumbull/#person>,
        <https://culturalcartography.net/names/joshua-reynolds/#person> ;
    foaf:name "John Singleton Copley" ;
    wkw:birthPlaceText "Boston, Mass." ;
    wkw:datesText "1738 (Boston, Mass.) – 1815 (London)" ;
