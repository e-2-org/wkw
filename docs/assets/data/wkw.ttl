<https://culturalcartography.net/names/robert-koch/#person> a foaf:Person ;
    rdfs:label "Robert Koch" ;
    dcterms:description "Koch did crucial research on anthrax, tuberculosis, cholera and other diseases, and with his associates was responsible for major advances in laboratory technique. He studied for his doctorate under Henle; they developed an important set of postulates. Cohn helped him by publishing his paper on anthrax; the influential Virchow was however antagonised by his work on tuberculosis. Koch and Pasteur conducted an acrimonious dispute about vaccination, further fuelled by current Franco-German rivalries. Always difficult to work with, Ehrlich, Behring and Kitasato were among his eminent students (he and Behring eventually fell out)."@en ;
    rdfs:seeAlso <https://www.nobelprize.org/prizes/medicine/1905/koch/biographical/>,
        <https://www.whonamedit.com/doctor.cfm/2987.html> ;
    owl:sameAs wd:Q37193 ;
    foaf:familyName "Koch" ;
    foaf:givenName "Robert" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/robert-koch/>,
        <https://en.wikipedia.org/wiki/Robert_Koch> ;
    foaf:knows <https://culturalcartography.net/names/charles-chamberland/#person>,
        <https://culturalcartography.net/names/emil-von-behring/#person>,
        <https://culturalcartography.net/names/ferdinand-cohn/#person>,
        <https://culturalcartography.net/names/friedrich-gustav-jakob-henle/#person>,
        <https://culturalcartography.net/names/ilya-mechnikov/#person>,
        <https://culturalcartography.net/names/joseph-lister/#person>,
        <https://culturalcartography.net/names/louis-pasteur/#person>,
        <https://culturalcartography.net/names/max-von-pettenkofer/#person>,
        <https://culturalcartography.net/names/paul-ehrlich/#person>,
        <https://culturalcartography.net/names/rudolf-virchow/#person>,
        <https://culturalcartography.net/names/shibasaburo-kitasato/#person> ;
    foaf:name "Robert Koch" ;
