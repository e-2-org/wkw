        <https://culturalcartography.net/names/samuel-taylor-coleridge/#person>,
        <https://culturalcartography.net/names/thomas-paine/#person> ;
    foaf:name "Robert Fulton" ;
    wkw:birthPlaceText "Lancaster County, Pa." ;
    wkw:datesText "1765 (Lancaster County, Pa.) – 1815 (New York)" ;
    wkw:deathPlaceText "New York" ;
