        <https://culturalcartography.net/names/voltaire/#person>,
        <https://culturalcartography.net/names/william-congreve/#person> ;
    foaf:name "John Gay" ;
    wkw:birthPlaceText "Barnstaple, England" ;
    wkw:datesText "1685 (Barnstaple, England) – 1732 (London)" ;
    wkw:deathPlaceText "London" ;
    wkw:sortKey "Gay, John" ;
