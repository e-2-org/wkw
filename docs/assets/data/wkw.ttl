<https://culturalcartography.net/names/hyppolite-fizeau/#person> a foaf:Person ;
    rdfs:label "Hyppolite Fizeau" ;
    dcterms:description "Foucault was a schoolfriend; they both abandoned medical studies for physics. Fizeau studied with Arago and Regnault. He and Foucault worked together on the velocity of light following ideas suggested by Arago, whose eyesight was failing, but parted ways shortly before the crucial experiments (Fizeau got there first). They also took the first clear photo of the moon's surface."@en ;
    rdfs:seeAlso <https://www-history.mcs.st-andrews.ac.uk/Biographies/Fizeau.html>,
        <https://www.encyclopedia.com/science/dictionaries-thesauruses-pictures-and-press-releases/fizeau-armand-hippolyte-louis> ;
    owl:sameAs wd:Q216814 ;
    foaf:familyName "Fizeau" ;
    foaf:givenName "Hyppolite" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/hyppolite-fizeau/>,
        <https://en.wikipedia.org/wiki/Hippolyte_Fizeau> ;
    foaf:knows <https://culturalcartography.net/names/francois-arago/#person>,
        <https://culturalcartography.net/names/henri-victor-regnault/#person>,
        <https://culturalcartography.net/names/leon-foucault/#person> ;
