        <https://culturalcartography.net/names/elizabeth-gould/#person>,
        <https://culturalcartography.net/names/john-gilbert/#person>,
        <https://culturalcartography.net/names/joseph-wolf/#person> ;
    foaf:name "John Gould" ;
    wkw:birthPlaceText "Lyme Regis, England" ;
    wkw:datesText "1804 (Lyme Regis, England) – 1881 (London)" ;
