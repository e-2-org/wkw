<https://culturalcartography.net/names/thomas-love-peacock/#person> a foaf:Person ;
    rdfs:label "Thomas Love Peacock" ;
    dcterms:description "Peacock is often remembered primarily for his close friendship with Percy Shelley — at times, being an almost daily visitor — though they exerted little if any overt literary influence on one another. Peacock and James Mill were appointed at the same time to posts with the East India Company, Peacock being supervised by Mill before succeeding him in his position, a useful one for a writer (Mill's son J. S. Mill in turn succeeded Peacock); the views of both Mills influenced his thought. Leigh Hunt effectively 'inherited' him as a friend from Shelley. Meredith married his daughter, and was influenced and helped by him."@en ;
    rdfs:seeAlso <https://authorscalendar.info/peacock.htm>,
        <https://www.britannica.com/biography/Thomas-Love-Peacock> ;
    owl:sameAs wd:Q561408 ;
    foaf:familyName "Peacock" ;
    foaf:givenName "Thomas Love" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/thomas-love-peacock/>,
        <https://en.wikipedia.org/wiki/Thomas_Love_Peacock> ;
    foaf:knows <https://culturalcartography.net/names/george-meredith/#person>,
        <https://culturalcartography.net/names/henry-cole/#person>,
        <https://culturalcartography.net/names/james-leigh-hunt/#person>,
        <https://culturalcartography.net/names/james-mill/#person>,
        <https://culturalcartography.net/names/john-stuart-mill/#person>,
        <https://culturalcartography.net/names/mary-shelley/#person>,
        <https://culturalcartography.net/names/percy-bysshe-shelley/#person> ;
    foaf:name "Thomas Love Peacock" ;
    wkw:birthPlaceText "Weymouth, England" ;
    wkw:datesText "1785 (Weymouth, England) – 1866 (Lower Halliford)" ;
    wkw:deathPlaceText "Lower Halliford" ;
