        <https://culturalcartography.net/names/rudolf-virchow/#person>,
        <https://culturalcartography.net/names/svante-arrhenius/#person> ;
    foaf:name "Lothar Meyer" ;
    wkw:birthPlaceText "Varel, Germany" ;
    wkw:datesText "1830 (Varel, Germany) – 1895 (Tübingen)" ;
    wkw:deathPlaceText "Tübingen" ;
    wkw:sortKey "Meyer, Lothar" ;
