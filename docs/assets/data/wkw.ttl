<https://culturalcartography.net/names/moliere/#person> a foaf:Person ;
    rdfs:label "Molière" ;
    dcterms:description "Often regarded as second only to Shakespeare, Molière remains one of the greats of European literature, known particularly for a series of comedies that puncture bourgeois pretension. He collaborated several times with Lully (eventually falling out), with Charpentier, and with his longstanding colleague Corneille. Molière, his close contemporary La Fontaine, and the younger Boileau (both friend and supporter) and Racine, were celebrated as the so-called Quartet of the rue du Vieux Colombier. Having premiered Racine's first play, Molière’s relations with him went disastrously wrong. He died following an onstage haemorrhage while playing the hypochondriac in his own Le Malade imaginaire."@en ;
    rdfs:seeAlso <https://www.britannica.com/biography/Moliere-French-dramatist> ;
    owl:sameAs wd:Q687 ;
    foaf:familyName "Molière" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/moliere/>,
        <https://en.wikipedia.org/wiki/Molière> ;
    foaf:knows <https://culturalcartography.net/names/antoine-furetiere/#person>,
        <https://culturalcartography.net/names/jean-baptiste-lully/#person>,
        <https://culturalcartography.net/names/jean-de-la-fontaine/#person>,
        <https://culturalcartography.net/names/jean-racine/#person>,
        <https://culturalcartography.net/names/marc-antoine-charpentier/#person>,
        <https://culturalcartography.net/names/nicolas-boileau/#person>,
        <https://culturalcartography.net/names/pierre-corneille/#person> ;
    foaf:name "Molière" ;
    wkw:birthPlaceText "Paris" ;
    wkw:datesText "1622 (Paris) – 1673 (Paris)" ;
    wkw:deathPlaceText "Paris" ;
    wkw:sortKey "Molière" ;
