<https://culturalcartography.net/names/francis-hutcheson/#person> a foaf:Person ;
    rdfs:label "Francis Hutcheson" ;
    dcterms:description "Hutcheson was responsible for Glasgow's role in the Scottish Enlightenment, influencing both Hume and Smith, its greatest figures. Lesser known than he might be (because while teaching in English, he published in Latin), his textbooks were influential in Scottish and U.S. universities through the 18th C. Smith and Reid were students of his (he has been described as his students' banker, guardian and friend); Smith fondly called him \"never to be forgotten\". Hume cut his teeth in philosophical jousting with Hutcheson, and although Hutcheson tried to hinder Hume's career, they corresponded until Hutcheson's death."@en ;
    rdfs:seeAlso <https://www.scottishphilosophy.org/philosophers/francis-hutcheson/>,
        <https://www.universitystory.gla.ac.uk/biography/?id=WH0191&type=P> ;
    owl:sameAs wd:Q316367 ;
    foaf:familyName "Hutcheson" ;
    foaf:givenName "Francis" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/francis-hutcheson/>,
        <https://en.wikipedia.org/wiki/Francis_Hutcheson_(philosopher)> ;
    foaf:knows <https://culturalcartography.net/names/adam-smith/#person>,
        <https://culturalcartography.net/names/david-hume/#person>,
        <https://culturalcartography.net/names/thomas-reid/#person> ;
    foaf:name "Francis Hutcheson" ;
    wkw:birthPlaceText "Saintfield, Ireland" ;
    wkw:datesText "1694 (Saintfield, Ireland) – 1746 (Dublin)" ;
    wkw:deathPlaceText "Dublin" ;
    wkw:sortKey "Hutcheson, Francis" ;
    wkw:status "bio" ;
    wkw:wordpressId 3665 ;
    schema:birthDate "1694"^^xsd:gYear ;
    schema:deathDate "1746"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/philosopher/#concept>,
        <https://culturalcartography.net/professions/teacher/#concept> .

