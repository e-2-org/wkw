<https://culturalcartography.net/names/henry-david-thoreau/#person> a foaf:Person ;
    rdfs:label "Henry David Thoreau" ;
    dcterms:description "Thoreau, not as reclusive as reputed, was friends (often close) with many authors of mid-19th-century classics. He worked for his neighbour and mentor Emerson as tutor, handyman and gardener. Hawthorne was a fireside companion, described his ugliness as honest and agreeable, and took him to dine with Longfellow. Whitman gave him a personal copy of 'Leaves of Grass'. Thoreau told Louisa May Alcott how frogs were more confiding in the spring (she said that his beard would deflect amorous advances). He built a fancy summerhouse for her father, and sent Agassiz specimens from Walden Pond at age 12."@en ;
    rdfs:seeAlso <https://authorscalendar.info/thoreau.htm>,
        <https://plato.stanford.edu/entries/thoreau/>,
        <https://www.guardian.co.uk/books/2004/jun/26/classics> ;
    owl:sameAs wd:Q131149 ;
    foaf:familyName "Thoreau" ;
    foaf:givenName "Henry David" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/henry-david-thoreau/> ;
    foaf:knows <https://culturalcartography.net/names/amos-bronson-alcott/#person>,
        <https://culturalcartography.net/names/henry-wadsworth-longfellow/#person>,
        <https://culturalcartography.net/names/louis-agassiz/#person>,
        <https://culturalcartography.net/names/louisa-may-alcott/#person>,
        <https://culturalcartography.net/names/margaret-fuller/#person>,
        <https://culturalcartography.net/names/nathaniel-hawthorne/#person>,
        <https://culturalcartography.net/names/ralph-waldo-emerson/#person>,
        <https://culturalcartography.net/names/walt-whitman/#person>,
        <https://culturalcartography.net/names/william-dean-howells/#person> ;
    foaf:name "Henry David Thoreau" ;
    wkw:birthPlaceText "Concord, Mass." ;
    wkw:datesText "1817 (Concord, Mass.) – 1862 (Concord)" ;
    wkw:deathPlaceText "Concord" ;
