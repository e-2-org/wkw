        <https://culturalcartography.net/names/nicola-porpora/#person>,
        <https://culturalcartography.net/names/pietro-metastasio/#person> ;
    foaf:name "Leonardo Vinci" ;
    wkw:birthPlaceText "Strongoli, Kingdom of Naples" ;
    wkw:datesText "1690 (Strongoli, Kingdom of Naples) – 1730 (Naples)" ;
    wkw:deathPlaceText "Naples" ;
    wkw:sortKey "Vinci, Leonardo" ;
