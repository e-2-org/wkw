<https://culturalcartography.net/names/william-siemens/#person> a foaf:Person ;
    rdfs:label "William Siemens" ;
    dcterms:description "Siemens corresponded with Wheatstone about electromagnetic issues, and together they invented a self-excited generator. He spent two days showing Faraday around his revolutionary gas furnace in Birmingham, but when Faraday gave his lecture about it he accidentally burned his notes (Siemens later named a cable-laying ship after Faraday). Werner von Siemens was his brother and fellow engineer."@en ;
    rdfs:seeAlso <https://www.britannica.com/biography/William-Siemens>,
        <https://www.encyclopedia.com/people/science-and-technology/electrical-engineering-biographies/sir-william-siemens> ;
    owl:sameAs wd:Q62377 ;
    skos:altLabel "Wilhelm Siemens;Carl Wilhelm Siemens;Sir William Siemens" ;
    foaf:familyName "Siemens" ;
    foaf:givenName "William" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/william-siemens/>,
        <https://en.wikipedia.org/wiki/Carl_Wilhelm_Siemens> ;
