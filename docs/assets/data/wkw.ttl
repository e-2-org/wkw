        <https://culturalcartography.net/names/jacob-b-winslow/#person>,
        <https://culturalcartography.net/names/john-pringle/#person> ;
    foaf:name "Bernhard Siegfried Albinus" ;
    wkw:birthPlaceText "Frankfurt [Oder], Germany" ;
    wkw:datesText "1697 (Frankfurt [Oder], Germany) – 1770 (Leiden, Netherlands)" ;
    wkw:deathPlaceText "Leiden, Netherlands" ;
    wkw:sortKey "Albinus, Bernhardsiegfried" ;
    wkw:status "bio" ;
