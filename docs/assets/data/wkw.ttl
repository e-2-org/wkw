        <https://culturalcartography.net/names/rene-just-hauy/#person> ;
    foaf:name "Louis Jean-Marie Daubenton" ;
    wkw:birthPlaceText "Montbard, France" ;
    wkw:datesText "1716 (Montbard, France) – 1800 (Paris)" ;
    wkw:deathPlaceText "Paris" ;
