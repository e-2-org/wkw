<https://culturalcartography.net/names/franz-bopp/#person> a foaf:Person ;
    rdfs:label "Franz Bopp" ;
    dcterms:description "Bopp was one of the great comparative linguists, establishing the deep grammatical relationship of Sanskrit with Greek, Latin, and other European languages. Wilkins' grammar helped him teach himself Sanskrit, though in Paris he also befriended and was taught by Hamilton. Schlegel, another to have profound influence on the field, also studied with Hamilton before being taught by Bopp. In London, he met Wilkins and Colebrooke. Humboldt studied with him there, becoming a great friend and mentor, and got him appointed to the university in Berlin. Müller and Bréal were also among his students."@en ;
    rdfs:seeAlso <https://vunex.blogspot.com/2006/10/franz-bopp.html> ;
    owl:sameAs wd:Q76934 ;
    foaf:familyName "Bopp" ;
    foaf:givenName "Franz" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/franz-bopp/>,
        <https://en.wikipedia.org/wiki/Franz_Bopp> ;
    foaf:knows <https://culturalcartography.net/names/alexander-hamilton/#person>,
        <https://culturalcartography.net/names/august-wilhelm-schlegel/#person>,
        <https://culturalcartography.net/names/charles-wilkins/#person>,
        <https://culturalcartography.net/names/henry-thomas-colebrooke/#person>,
        <https://culturalcartography.net/names/max-muller/#person>,
        <https://culturalcartography.net/names/michel-breal/#person>,
        <https://culturalcartography.net/names/wilhelm-von-humboldt/#person> ;
    foaf:name "Franz Bopp" ;
    wkw:birthPlaceText "Mainz, Germany" ;
    wkw:datesText "1791 (Mainz, Germany) – 1867 (Berlin)" ;
    wkw:deathPlaceText "Berlin" ;
