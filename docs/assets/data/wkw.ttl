<https://culturalcartography.net/names/sophie-germain/#person> a foaf:Person ;
    rdfs:label "Sophie Germain" ;
    dcterms:description "Disbarred as a woman from formal study, Germain sent Lagrange a term-paper under a male pseudonym. Greatly impressed by it, he asked to meet its author, was duly astonished to discover her gender, and took her on as his protégée. Cauchy and (especially) Fourier became supportive friends, not least in the face of deliberate frostiness from Poisson and his allies. She wrote to Legendre about number-theory, the ensuing correspondence amounting to a full collaboration. She and Gauss corresponded for some years; she helped ensure his safety, while he proposed her for an honorary degree, the first to a woman."@en ;
    rdfs:seeAlso <https://www-history.mcs.st-andrews.ac.uk/Biographies/Germain.html>,
        <https://www.uh.edu/engines/epi223.htm> ;
    owl:sameAs wd:Q7103 ;
    skos:altLabel "Marie-Sophie Germain" ;
    foaf:familyName "Germain" ;
    foaf:givenName "Sophie" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/sophie-germain/>,
        <https://en.wikipedia.org/wiki/Sophie_Germain> ;
    foaf:knows <https://culturalcartography.net/names/adrien-marie-legendre/#person>,
        <https://culturalcartography.net/names/augustin-louis-cauchy/#person>,
        <https://culturalcartography.net/names/carl-friedrich-gauss/#person>,
        <https://culturalcartography.net/names/joseph-fourier/#person>,
        <https://culturalcartography.net/names/joseph-louis-lagrange/#person> ;
    foaf:name "Sophie Germain" ;
    wkw:birthPlaceText "Paris" ;
    wkw:datesText "1776 (Paris) – 1831 (Paris)" ;
    wkw:deathPlaceText "Paris" ;
    wkw:sortKey "Germain, Sophie" ;
    wkw:status "bio" ;
    wkw:wordpressId 3533 ;
    schema:birthDate "1776"^^xsd:gYear ;
    schema:deathDate "1831"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/mathematician/#concept> .

