        <https://en.wikipedia.org/wiki/Edward_S._Morse> ;
    foaf:knows <https://culturalcartography.net/names/louis-agassiz/#person>,
        <https://culturalcartography.net/names/percival-lowell/#person> ;
    foaf:name "Edward S. Morse" ;
    wkw:birthPlaceText "Portland, Maine" ;
