        <https://culturalcartography.net/names/robert-creeley/#person>,
        <https://culturalcartography.net/names/ron-silliman/#person> ;
    foaf:name "Charles Bernstein" ;
    wkw:birthPlaceText "New York" ;
    wkw:datesText "1950 (New York) –" ;
    wkw:sortKey "Bernstein, Charles" ;
    wkw:status "bio" ;
    wkw:wordpressId 3186 ;
