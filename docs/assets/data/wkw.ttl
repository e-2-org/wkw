        <https://culturalcartography.net/names/julius-schnorr-von-carolsfeld/#person>,
        <https://culturalcartography.net/names/peter-von-cornelius/#person> ;
    foaf:name "Friedrich Olivier" ;
    wkw:birthPlaceText "Dessau, Germany" ;
    wkw:datesText "1791 (Dessau, Germany) – 1859 (Dessau)" ;
    wkw:deathPlaceText "Dessau" ;
    wkw:sortKey "Olivier, Friedrich" ;
