<https://culturalcartography.net/names/theodore-rousseau/#person> a foaf:Person ;
    rdfs:label "Théodore Rousseau" ;
    dcterms:description "Rousseau was a leading light in the group known as the Barbizon school, seen as direct precursors to the Impressionists. Daumier (who spent summer holidays at Rousseau's), Daubigny and Millet were also active in this circle, though Millet — Rousseau's closest friend — worked outside its immediate concerns, as did Corot, another close friend. It seems likely that Rousseau, who split his time between Paris and Barbizon, knew both Baudelaire (who wrote about him) and Delacroix (who met with him at least once). Gautier, friend and correspondent, called him a 'remarkable conversationalist.' He resisted Sand's scheming of marriage to her adopted daughter."@en ;
    rdfs:seeAlso <https://www.artchive.com/artchive/T/trousseau.html>,
        <https://www.artnet.com/artists/théodore-rousseau/>,
        <https://www.nga.gov/collection/artist-info.1846.html> ;
    owl:sameAs wd:Q310025 ;
    foaf:familyName "Rousseau" ;
    foaf:givenName "Théodore" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/theodore-rousseau/>,
        <https://en.wikipedia.org/wiki/Théodore_Rousseau> ;
    foaf:knows <https://culturalcartography.net/names/camille-corot/#person>,
        <https://culturalcartography.net/names/charles-francois-daubigny/#person>,
        <https://culturalcartography.net/names/george-sand/#person>,
        <https://culturalcartography.net/names/honore-daumier/#person>,
        <https://culturalcartography.net/names/jean-francois-millet/#person>,
        <https://culturalcartography.net/names/johan-barthold-jongkind/#person>,
        <https://culturalcartography.net/names/theophile-gautier/#person> ;
    foaf:name "Théodore Rousseau" ;
    wkw:birthPlaceText "Paris" ;
    wkw:datesText "1812 (Paris) – 1867 (Barbizon, France)" ;
    wkw:deathPlaceText "Barbizon, France" ;
    wkw:sortKey "Rousseau, Theodore" ;
    wkw:status "bio" ;
    wkw:wordpressId 4102 ;
    schema:birthDate "1812"^^xsd:gYear ;
    schema:deathDate "1867"^^xsd:gYear ;
