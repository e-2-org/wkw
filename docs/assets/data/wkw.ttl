<https://culturalcartography.net/names/max-von-pettenkofer/#person> a foaf:Person ;
    rdfs:label "Max von Pettenkofer" ;
    dcterms:description "Pettenkofer studied under Liebig; it was Pettenkofer's own work as a research student that led Liebig onto his own important work on meat extracts. In Munich, he was joined by a younger of Liebig's students, Voit: they founded a biological journal together, and in a long collaboration, effectively founded modern nutritional science (Pettenkofer providing resources and some essential skills, while Voit did the bulk of the work). Koch visited him to discuss his (Koch's) radical new theory about cholera epidemiology; while Pettenkofer disagreed, he later drunk a broth of cholera bacteria sent by Koch, and survived."@en ;
    rdfs:seeAlso <https://www.lshtm.ac.uk/aboutus/introducing/history/frieze/max-von-pettenkofer> ;
    owl:sameAs wd:Q44993 ;
    foaf:familyName "Pettenkofer" ;
    foaf:givenName "Max von" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/max-von-pettenkofer/>,
        <https://en.wikipedia.org/wiki/Max_Joseph_von_Pettenkofer> ;
    foaf:knows <https://culturalcartography.net/names/carl-von-voit/#person>,
        <https://culturalcartography.net/names/justus-von-liebig/#person>,
        <https://culturalcartography.net/names/robert-koch/#person> ;
    foaf:name "Max von Pettenkofer" ;
    wkw:birthPlaceText "Lichtenheim, Germany" ;
    wkw:datesText "1818 (Lichtenheim, Germany) – 1901 (Munich)" ;
    wkw:deathPlaceText "Munich" ;
    wkw:sortKey "Pettenkofer, Maxvon" ;
    wkw:status "bio" ;
    wkw:wordpressId 4011 ;
    schema:birthDate "1818"^^xsd:gYear ;
    schema:deathDate "1901"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/chemist/#concept>,
        <https://culturalcartography.net/professions/public-health-scientist/#concept> .

