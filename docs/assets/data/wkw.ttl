<https://culturalcartography.net/names/henri-murger/#person> a foaf:Person ;
    rdfs:label "Henri Murger" ;
    dcterms:description "A minor literary figure, Murger's pioneer writing about bohemian life was genuinely influential, and inspired the composers Verdi and Leoncavallo. He collaborated with his sidekick Banville (a novel in letter form), warned Manet about Delacroix, and died of syphilis in Nadar's arms. Along with Baudelaire, Courbet and Nadar, he belonged to a coterie who hung out at a café where the owner allowed his hard-up customers to share a single coffee, reckoning to cash in on their eventual fame (he did). The older Musset, already established, was another friend. Whistler, something of a groupie, embarrassed him by his attentions."@en ;
    rdfs:seeAlso <https://www.litkicks.com/HenryMurger>,
        <https://www.pennilesspress.co.uk/prose/henry_murger__bohemia.htm> ;
    owl:sameAs wd:Q31258 ;
    skos:altLabel "Henry Murger;Henri Mürger;Louis-Henri Murger" ;
    foaf:familyName "Murger" ;
    foaf:givenName "Henri" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/henri-murger/>,
        <https://en.wikipedia.org/wiki/Henri_Murger> ;
    foaf:knows <https://culturalcartography.net/names/alfred-de-musset/#person>,
        <https://culturalcartography.net/names/charles-baudelaire/#person>,
        <https://culturalcartography.net/names/edouard-manet/#person>,
        <https://culturalcartography.net/names/gustave-courbet/#person>,
        <https://culturalcartography.net/names/james-mcneill-whistler/#person>,
        <https://culturalcartography.net/names/nadar/#person>,
        <https://culturalcartography.net/names/theodore-de-banville/#person> ;
    foaf:name "Henri Murger" ;
    wkw:birthPlaceText "Paris" ;
    wkw:datesText "1822 (Paris) – 1861 (Paris)" ;
    wkw:deathPlaceText "Paris" ;
    wkw:sortKey "Murger, Henri" ;
    wkw:status "bio" ;
    wkw:wordpressId 3930 ;
    schema:birthDate "1822"^^xsd:gYear ;
    schema:deathDate "1861"^^xsd:gYear ;
