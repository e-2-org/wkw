<https://culturalcartography.net/names/joseph-lister/#person> a foaf:Person ;
    rdfs:label "Joseph Lister" ;
    dcterms:description "Pasteur and Lister became great friends (Lister's familiarity with the spoiling of wine — his father J. J. Lister was a wine-merchant by day — helped him see how Pasteur's biochemical theories could be applied to sepsis in wounds). He did his best at a London congress to promote a civilised meeting between Pasteur and Koch (the three of them leading the way in the bacteriological understanding of infection and immunity). He was also strongly supportive of Mechnikov, whose ideas had been under fire, and became a friend. Cohn introduced Koch to him, while Babbage and Roux were among his correspondents."@en ;
    rdfs:seeAlso <https://broughttolife.sciencemuseum.org.uk/broughttolife/people/josephlister>,
        <https://www.britannica.com/biography/Joseph-Lister-Baron-Lister-of-Lyme-Regis> ;
    owl:sameAs wd:Q155768 ;
    foaf:familyName "Lister" ;
    foaf:givenName "Joseph" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/joseph-lister/>,
        <https://en.wikipedia.org/wiki/Joseph_Lister> ;
    foaf:knows <https://culturalcartography.net/names/charles-babbage/#person>,
        <https://culturalcartography.net/names/emile-roux/#person>,
        <https://culturalcartography.net/names/ferdinand-cohn/#person>,
        <https://culturalcartography.net/names/ilya-mechnikov/#person>,
        <https://culturalcartography.net/names/joseph-jackson-lister/#person>,
        <https://culturalcartography.net/names/louis-pasteur/#person>,
        <https://culturalcartography.net/names/robert-koch/#person> ;
    foaf:name "Joseph Lister" ;
