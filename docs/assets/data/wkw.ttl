<https://culturalcartography.net/names/lee-krasner/#person> a foaf:Person ;
    rdfs:label "Lee Krasner" ;
    dcterms:description "Hofmann taught her. She met Pollock, whom she ended up marrying, by going to his studio and asking to see his work when she didn’t recognise his name on a list of fellow-exhibitors. Mondrian, one of her influences, was met as a fellow-member of a New York abstractionist group. She illustrated O’Hara’s verse, while Motherwell translated from French for her. Both Hartigan (whom Krasner recommended for exhibitions) and Frankenthaler (a weekend visitor) became close friends; de Kooning, already a friend, became a Long Island neighbour (though Krasner and Elaine de Kooning never became close)."@en ;
    rdfs:seeAlso <https://jwa.org/encyclopedia/article/krasner-lee>,
        <https://nmwa.org/explore/artist-profiles/lee-krasner>,
        <https://www.stonybrook.edu/commcms/pkhouse/our-story/krasner.php> ;
    owl:sameAs wd:Q237959 ;
    foaf:familyName "Krasner" ;
    foaf:givenName "Lee" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/lee-krasner/> ;
    foaf:knows <https://culturalcartography.net/names/frank-ohara/#person>,
        <https://culturalcartography.net/names/grace-hartigan/#person>,
        <https://culturalcartography.net/names/hans-hofmann/#person>,
        <https://culturalcartography.net/names/helen-frankenthaler/#person>,
        <https://culturalcartography.net/names/jackson-pollock/#person>,
        <https://culturalcartography.net/names/piet-mondrian/#person>,
        <https://culturalcartography.net/names/robert-motherwell/#person>,
        <https://culturalcartography.net/names/willem-de-kooning/#person> ;
    foaf:name "Lee Krasner" ;
    wkw:birthPlaceText "New York" ;
    wkw:datesText "1908 (New York) – 1984 (New York)" ;
    wkw:deathPlaceText "New York" ;
    wkw:sortKey "Krasner, Lee" ;
    wkw:status "bio" ;
