        <https://culturalcartography.net/names/mary-somerville/#person>,
        <https://culturalcartography.net/names/urbain-le-verrier/#person> ;
    foaf:name "John Couch Adams" ;
    wkw:birthPlaceText "Lidcott, Cornwall, England" ;
    wkw:datesText "1819 (Lidcott, Cornwall, England) – 1892 (Cambridge, England)" ;
    wkw:deathPlaceText "Cambridge, England" ;
    wkw:sortKey "Adams, Johncouch" ;
    wkw:status "bio" ;
