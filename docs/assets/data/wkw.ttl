<https://culturalcartography.net/names/anders-johan-lexell/#person> a foaf:Person ;
    rdfs:label "Anders Johan Lexell" ;
    dcterms:description "Lexell, who spent most of his career in Russia, is known for his work on cometary orbits and on spherical geometry. He arrived in St Petersburg when its eminence grise, Euler, was over 60 and practically blind. He helped Euler in his work as one of his disciples, became his friend and chosen successor, and was present when he died (Lexell himself however dying young, barely a year later). Linnaeus was one of his correspondents. Although Lexell wrote at least once to William Herschel, the discoverer of Uranus, confirming its status as a planet and calculating its orbit, the extent of any further contact is not clear."@en ;
    rdfs:seeAlso <https://www-history.mcs.st-andrews.ac.uk/Biographies/Lexell.html> ;
    owl:sameAs wd:Q447071 ;
    skos:altLabel "Andrei Ivanovich Leksel;Anders Johan Leksel;Anders Lexell" ;
    skos:editorialNote "Merged with Anders Lexell: Same person: Wikidata Q447071"@en ;
    foaf:familyName "Lexell" ;
    foaf:givenName "Anders Johan" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/anders-johan-lexell/>,
        <https://en.wikipedia.org/wiki/Anders_Johan_Lexell> ;
    foaf:knows <https://culturalcartography.net/names/carl-linnaeus/#person>,
        <https://culturalcartography.net/names/leonhard-euler/#person> ;
    foaf:name "Anders Johan Lexell" ;
    wkw:birthPlaceText "Åbo, Sweden, now Turku, Finland" ;
    wkw:datesText "1740 (Åbo, Sweden, now Turku, Finland) – 1784 (St Petersburg)" ;
    wkw:deathPlaceText "St Petersburg" ;
    wkw:sortKey "Lexell, Andersjohan" ;
    wkw:status "bio" ;
    wkw:wordpressId 3794,
        4917 ;
    schema:birthDate "1740"^^xsd:gYear ;
    schema:deathDate "1784"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/astronomer/#concept>,
        <https://culturalcartography.net/professions/mathematician/#concept> .

