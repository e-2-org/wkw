<https://culturalcartography.net/names/thomas-eakins/#person> a foaf:Person ;
    rdfs:label "Thomas Eakins" ;
    dcterms:description "Eakins assisted Muybridge in research he undertook in Philadelphia, and was directly influenced by his approach to photographing human and animal locomotion. Whitman and Eakins had a lot of mutual respect, perhaps grounded in the professional rebuffs both had experienced; Eakins painted and photographed Whitman (a set of images of a naked old man are probably also be of him). Henri studied under him briefly, and after his death, wrote about his honesty and integrity as an artist."@en ;
    rdfs:seeAlso <https://www.britannica.com/biography/Thomas-Eakins>,
        <https://www.pbs.org/wnet/americanmasters/database/eakins_t.html> ;
    owl:sameAs wd:Q214905 ;
    foaf:familyName "Eakins" ;
    foaf:givenName "Thomas" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/thomas-eakins/>,
        <https://en.wikipedia.org/wiki/Thomas_Eakins> ;
    foaf:knows <https://culturalcartography.net/names/eadweard-muybridge/#person>,
        <https://culturalcartography.net/names/robert-henri/#person>,
        <https://culturalcartography.net/names/walt-whitman/#person> ;
    foaf:name "Thomas Eakins" ;
    wkw:birthPlaceText "Philadelphia" ;
    wkw:datesText "1844 (Philadelphia) – 1916 (Philadelphia)" ;
    wkw:deathPlaceText "Philadelphia" ;
    wkw:sortKey "Eakins, Thomas" ;
    wkw:status "bio" ;
    wkw:wordpressId 3443 ;
    schema:birthDate "1844"^^xsd:gYear ;
    schema:deathDate "1916"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/artist/#concept> .

<https://culturalcartography.net/names/thomas-gray/#person> a foaf:Person ;
    rdfs:label "Thomas Gray" ;
    dcterms:description "Gray is regarded, after Pope, as the most important English 18th-century poet, despite being a severely self-censoring perfectionist (only thirteen pieces published in a lifetime). Walpole was a schoolfriend from the age of nine; they went on the Grand Tour together, quarrelled over their irreconcilable tastes, but made up later, Walpole's influence helping Gray's work get published, and Gray writing an ode to the death by drowning (in a goldfish bowl) of Walpole's cat. Notoriously reserved, Gray had few other friends, though friends or acquaintances probably included Goldsmith, Cowper, and perhaps Boswell and Johnson; Smart was a university colleague."@en ;
    rdfs:seeAlso <https://www.britannica.com/biography/Thomas-Gray-English-poet>,
        <https://www.thomasgray.org/resources/bio.shtml> ;
    owl:sameAs wd:Q315516 ;
    foaf:familyName "Gray" ;
    foaf:givenName "Thomas" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/thomas-gray/>,
        <https://en.wikipedia.org/wiki/Thomas_Gray> ;
    foaf:knows <https://culturalcartography.net/names/christopher-smart/#person>,
        <https://culturalcartography.net/names/horace-walpole/#person>,
        <https://culturalcartography.net/names/james-macpherson/#person> ;
    foaf:name "Thomas Gray" ;
    wkw:birthPlaceText "London" ;
    wkw:datesText "1716 (London) – 1771 (Cambridge)" ;
    wkw:deathPlaceText "Cambridge" ;
    wkw:sortKey "Gray, Thomas" ;
    wkw:status "bio" ;
    wkw:wordpressId 3570 ;
    schema:birthDate "1716"^^xsd:gYear ;
    schema:deathDate "1771"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/poet/#concept> .

<https://culturalcartography.net/names/thomas-lovell-beddoes/#person> a foaf:Person ;
