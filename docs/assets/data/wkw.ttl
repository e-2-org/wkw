        <https://culturalcartography.net/names/wilhelm-weber/#person> ;
    foaf:name "William Siemens" ;
    wkw:birthPlaceText "Lenthe, Germany" ;
    wkw:datesText "1823 (Lenthe, Germany) – 1883 (London)" ;
    wkw:deathPlaceText "London" ;
