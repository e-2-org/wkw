<https://culturalcartography.net/names/adolph-strecker/#person> a foaf:Person ;
    rdfs:label "Adolph Strecker" ;
    dcterms:description "Strecker was the first person to synthesise an amino acid (alanine). He studied under Liebig, then returned as his assistant, teaching Kekulé (among others) organic chemistry. Meyer, working under Liebig at the same time, became a good friend. Miescher (who importantly went on to isolate the DNA molecule) worked as a research student under his guidance. Strecker is credited as co-author of the German edition of Regnault's influential chemistry text-book; while both were graduates of Liebig's laboratory, it is unclear what contact the two had."@en ;
    owl:sameAs wd:Q63747 ;
    foaf:familyName "Strecker" ;
    foaf:givenName "Adolph" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/adolph-strecker/>,
        <https://en.wikipedia.org/wiki/Adolph_Strecker> ;
    foaf:knows <https://culturalcartography.net/names/august-kekule/#person>,
        <https://culturalcartography.net/names/friedrich-miescher/#person>,
        <https://culturalcartography.net/names/justus-von-liebig/#person>,
        <https://culturalcartography.net/names/lothar-meyer/#person> ;
    foaf:name "Adolph Strecker" ;
    wkw:birthPlaceText "Darmstadt, Germany" ;
    wkw:datesText "1822 (Darmstadt, Germany) – 1871 (Würzburg)" ;
    wkw:deathPlaceText "Würzburg" ;
    wkw:sortKey "Strecker, Adolph" ;
    wkw:status "bio" ;
