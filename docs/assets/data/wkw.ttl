        <https://culturalcartography.net/names/johann-wolfgang-von-goethe/#person>,
        <https://culturalcartography.net/names/sigismond-von-neukomm/#person>,
        <https://culturalcartography.net/names/sigismund-von-neukomm/#person> ;
    foaf:name "Carl Friedrich Zelter" ;
