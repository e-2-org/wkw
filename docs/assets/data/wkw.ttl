        <https://culturalcartography.net/names/karl-friedrich-schimper/#person>,
        <https://culturalcartography.net/names/lorenz-oken/#person>,
        <https://culturalcartography.net/names/louis-agassiz/#person> ;
    foaf:name "Alexander Braun" ;
    wkw:birthPlaceText "Regensburg, Germany" ;
    wkw:datesText "1805 (Regensburg, Germany) – 1877 (Berlin)" ;
    wkw:deathPlaceText "Berlin" ;
