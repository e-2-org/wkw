        <https://culturalcartography.net/names/jean-paul-sartre/#person>,
        <https://culturalcartography.net/names/marcel-ophuls/#person>,
        <https://culturalcartography.net/names/michel-tournier/#person>,
        <https://culturalcartography.net/names/simone-de-beauvoir/#person> ;
    foaf:name "Claude Lanzmann" ;
    wkw:birthPlaceText "Paris" ;
    wkw:datesText "1925 (Paris) – 2018 (Paris)" ;
    wkw:deathPlaceText "Paris" ;
    wkw:sortKey "Lanzmann, Claude" ;
    wkw:status "bio" ;
    wkw:wordpressId 3759 ;
    schema:birthDate "1925"^^xsd:gYear ;
    schema:deathDate "2018"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/film-maker/#concept>,
        <https://culturalcartography.net/professions/journalist/#concept> .

<https://culturalcartography.net/names/claude-parent/#person> a foaf:Person ;
    rdfs:label "Claude Parent" ;
    dcterms:description "Parent worked briefly for Le Corbusier. Virilio and he collaborated both as architects and theorists, developing ideas about 'the oblique', inspired partly by children playing on abandoned wartime bunkers; Nouvel worked with them as a young architect before establishing his own practice. Parent collaborated with Tinguely and Klein, helping Klein develop designs for fountains of fire and water, and a ceiling of air."@en ;
    rdfs:seeAlso <https://032c.com/the-supermodernist-architect-claude-parent/>,
        <https://www.dezeen.com/2016/03/01/claude-parent-french-architect-dies-aged-93-tributes-zaha-hadid-daniel-libeskind-jean-nouvel/>,
        <https://www.wallpaper.com/design/remembering-the-life-of-the-provocative-architect-claude-parent> ;
    owl:sameAs wd:Q2977923 ;
    foaf:familyName "Parent" ;
    foaf:givenName "Claude" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/claude-parent/> ;
    foaf:knows <https://culturalcartography.net/names/jean-nouvel/#person>,
        <https://culturalcartography.net/names/jean-tinguely/#person>,
        <https://culturalcartography.net/names/le-corbusier/#person>,
        <https://culturalcartography.net/names/paul-virilio/#person>,
        <https://culturalcartography.net/names/yves-klein/#person> ;
    foaf:name "Claude Parent" ;
    wkw:birthPlaceText "Neuilly, France" ;
    wkw:datesText "1923 (Neuilly, France) – 2016 (Neuilly)" ;
    wkw:deathPlaceText "Neuilly" ;
    wkw:sortKey "Parent, Claude" ;
    wkw:status "bio" ;
    wkw:wordpressId 3987 ;
    schema:birthDate "1923"^^xsd:gYear ;
    schema:deathDate "2016"^^xsd:gYear ;
