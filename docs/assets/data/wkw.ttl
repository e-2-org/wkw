        <https://culturalcartography.net/names/lord-monboddo/#person>,
        <https://culturalcartography.net/names/thomas-blacklock/#person>,
        <https://culturalcartography.net/names/walter-scott/#person>,
        <https://culturalcartography.net/names/william-smellie-encyclopaedist/#person> ;
    foaf:name "Robert Burns" ;
    wkw:birthPlaceText "Alloway, Scotland" ;
