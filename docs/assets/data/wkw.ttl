        <https://culturalcartography.net/names/raymond-roussel/#person>,
        <https://culturalcartography.net/names/victor-hugo/#person> ;
    foaf:name "Jules Verne" ;
    wkw:birthPlaceText "Nantes, France" ;
    wkw:datesText "1828 (Nantes, France) – 1905 (Amiens)" ;
