        <https://culturalcartography.net/names/john-locke/#person>,
        <https://culturalcartography.net/names/john-wallis/#person>,
        <https://culturalcartography.net/names/robert-boyle/#person> ;
    foaf:name "Nicolas Fatio de Duillier" ;
