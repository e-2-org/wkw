        <https://culturalcartography.net/names/marquis-de-condorcet/#person> ;
    foaf:name "Félix Vicq d'Azyr" ;
    wkw:birthPlaceText "Valognes, France" ;
    wkw:datesText "1748 (Valognes, France) – 1794 (Paris)" ;
    wkw:deathPlaceText "Paris" ;
    wkw:sortKey "Vicqdazyr, Felix" ;
    wkw:status "bio" ;
