        <https://culturalcartography.net/names/theodor-adorno/#person>,
        <https://culturalcartography.net/names/willard-van-orman-quine/#person> ;
    foaf:name "Gilbert Ryle" ;
    wkw:birthPlaceText "Brighton, England" ;
