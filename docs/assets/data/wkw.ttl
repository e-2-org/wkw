<https://culturalcartography.net/names/joseph-plateau/#person> a foaf:Person ;
    rdfs:label "Joseph Plateau" ;
    dcterms:description "Plateau is known for his research into vision and into the mathematics of soap-film surfaces, and for the development of early cinematic devices. Quetelet taught and befriended him, drew him into his scientific circle, and was generally strongly influential. Plateau met Arago in France, while sourcing good laboratory equipment (he probably met his fellow-researcher into colour, Chevreul, on the same trip). He adapted ideas of Faraday's and Roget's, Faraday — a friend — writing sympathetically in his blindness. Despite Plateau's staring into the sun for experimental purposes, his eventual blindness probably had other primary causes."@en ;
    rdfs:seeAlso <https://www-groups.dcs.st-and.ac.uk/history/Biographies/Plateau.html>,
        <https://www.amazingbelgium.be/2015/10/joseph-plateau-inventor-of-moving.html> ;
    owl:sameAs wd:Q379993 ;
    foaf:familyName "Plateau" ;
    foaf:givenName "Joseph" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/joseph-plateau/>,
        <https://en.wikipedia.org/wiki/Joseph_Plateau> ;
    foaf:knows <https://culturalcartography.net/names/adolphe-quetelet/#person>,
        <https://culturalcartography.net/names/francois-arago/#person>,
        <https://culturalcartography.net/names/john-tyndall/#person>,
        <https://culturalcartography.net/names/michael-faraday/#person>,
        <https://culturalcartography.net/names/peter-mark-roget/#person> ;
    foaf:name "Joseph Plateau" ;
    wkw:birthPlaceText "Brussels" ;
    wkw:datesText "1801 (Brussels) – 1883 (Ghent, Belgium)" ;
    wkw:deathPlaceText "Ghent, Belgium" ;
    wkw:sortKey "Plateau, Joseph" ;
    wkw:status "bio" ;
    wkw:wordpressId 4024 ;
    schema:birthDate "1801"^^xsd:gYear ;
    schema:deathDate "1883"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/mathematician/#concept>,
