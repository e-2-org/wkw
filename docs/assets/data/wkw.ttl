<https://culturalcartography.net/names/jean-etienne-guettard/#person> a foaf:Person ;
    rdfs:label "Jean-Étienne Guettard" ;
    dcterms:description "Guettard, famously blunt, was a pioneer of geological field-work. He studied botany with Réaumur and Jussieu. Linnaeus corresponded, naming a genus after him; Haller and the amateur botanist Rousseau were also in contact. Lavoisier's father was a friend of Guettard, who employed the young Lavoisier as an assistant (encouraging him to go on to study chemistry); they made several geological field-trips together, and were commissioned to produce the first (unfinished) geological map of France. Daubenton was a close colleague. Buffon approvingly quoted Guettard's Polish researches, despite the animosity between them."@en ;
    rdfs:seeAlso <https://www.britannica.com/biography/Jean-Etienne-Guettard>,
        <https://www.encyclopedia.com/people/science-and-technology/geology-and-oceanography-biographies/jean-etienne-guettard> ;
    owl:sameAs wd:Q43273 ;
    foaf:familyName "Guettard" ;
    foaf:givenName "Jean-Étienne" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/jean-etienne-guettard/> ;
    foaf:knows <https://culturalcartography.net/names/albrecht-von-haller/#person>,
        <https://culturalcartography.net/names/antoine-lavoisier/#person>,
        <https://culturalcartography.net/names/bernard-de-jussieu/#person>,
        <https://culturalcartography.net/names/carl-linnaeus/#person>,
        <https://culturalcartography.net/names/comte-de-buffon/#person>,
        <https://culturalcartography.net/names/jean-jacques-rousseau/#person>,
        <https://culturalcartography.net/names/louis-jean-marie-daubenton/#person>,
        <https://culturalcartography.net/names/rene-antoine-de-reaumur/#person> ;
    foaf:name "Jean-Étienne Guettard" ;
    wkw:birthPlaceText "Étampes, France" ;
    wkw:datesText "1715 (Étampes, France) – 1786 (Paris)" ;
    wkw:deathPlaceText "Paris" ;
