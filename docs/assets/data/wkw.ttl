<https://culturalcartography.net/names/lewis-grassic-gibbon/#person> a foaf:Person ;
    rdfs:label "Lewis Grassic Gibbon" ;
    dcterms:description "Gibbon — the pen-name used by Mitchell for his best-known trilogy — was a significant contributor to the Scottish literary renaissance; his early death limited a wider reception for his works. MacDiarmid was a close friend and supportive colleague; they collaborated on one book, and even though they held very different views, were united in their hostility to the Scottish establishment. While H. G. Wells was reassuring in his praise of one of Gibbon's early novels, it is not clear whether they had any direct personal connection."@en ;
    rdfs:seeAlso <https://pubs.socialistreviewindex.org.uk/sr258/foot.htm>,
        <https://www.bbc.co.uk/scotland/arts/writingscotland/writers/lewis_grassic_gibbon/>,
        <https://www.undiscoveredscotland.co.uk/usbiography/g/lewisgrassicgibbon.html> ;
    owl:sameAs wd:Q650800 ;
    skos:altLabel "James Leslie Mitchell" ;
    foaf:familyName "Gibbon" ;
    foaf:givenName "Lewis Grassic" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/lewis-grassic-gibbon/> ;
    foaf:knows <https://culturalcartography.net/names/hugh-macdiarmid/#person> ;
    foaf:name "Lewis Grassic Gibbon" ;
    wkw:birthPlaceText "Paris" ;
    wkw:datesText "1901 (Paris) – 1935 (Welwyn, England)" ;
    wkw:deathPlaceText "Welwyn, England" ;
    wkw:sortKey "Gibbon, Lewis Grassic" ;
    wkw:status "bio" ;
    wkw:wordpressId 6037 ;
    schema:birthDate "1901"^^xsd:gYear ;
    schema:deathDate "1935"^^xsd:gYear ;
    schema:hasOccupation <https://culturalcartography.net/professions/writer/#concept> .

