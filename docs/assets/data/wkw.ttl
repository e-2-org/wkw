<https://culturalcartography.net/names/isaac-babel/#person> a foaf:Person ;
    rdfs:label "Isaac Babel" ;
    dcterms:description "Gorky published his early work, gave him good advice, and protected him against persecution. Ehrenburg, who called Babel a wise rabbi, was first met in Paris — they remained friends for life. Babel contributed to Mayakovsky's magazine 'Lef', collaborated with Eisenstein on a film, and suggested a good haven to Mandelstam (under investigation by the secret police), giving him the train-fare. Pasternak was a neighbour outside Moscow, and a depressing companion travelling to Paris for a conference organised by Malraux (whom Babel was later falsely accused of passing aviation secrets to, and shot)."@en ;
    rdfs:seeAlso <https://authorscalendar.info/babel.htm> ;
    owl:sameAs wd:Q49080 ;
    skos:altLabel "Isaac Emmanuilovich Babel;Isaac Emmanuelovich Babel" ;
    foaf:familyName "Babel" ;
    foaf:givenName "Isaac" ;
    foaf:isPrimaryTopicOf <https://culturalcartography.net/names/isaac-babel/>,
        <https://en.wikipedia.org/wiki/Isaac_Babel> ;
    foaf:knows <https://culturalcartography.net/names/andre-malraux/#person>,
        <https://culturalcartography.net/names/boris-pasternak/#person>,
        <https://culturalcartography.net/names/elias-canetti/#person>,
        <https://culturalcartography.net/names/ilya-ehrenburg/#person>,
        <https://culturalcartography.net/names/maxim-gorky/#person>,
        <https://culturalcartography.net/names/osip-mandelstam/#person>,
        <https://culturalcartography.net/names/sergei-eisenstein/#person>,
        <https://culturalcartography.net/names/vladimir-mayakovsky/#person> ;
    foaf:name "Isaac Babel" ;
    wkw:birthPlaceText "Odessa, Ukraine" ;
